{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "patch": {
      "description": "Builds code and fixes errors",
      "mode": "primary",
      "temperature": 0.1,
      "prompt": "You get one error at a time from @ws-build, then explain and fix those errors. Focus on explaining and fixing errors one at a time.",
      "permission": {
        "edit": "allow",
        "read": {
          "~/nixfiles/secrets/*": "deny"
        },
        "bash": "allow",
        "rm *": "deny",
        "external_directory": {
          "/nix/store/**": "allow",
          "~/*": "deny"
        },
        "skill": {
          "git-commit": "allow"
        }
      }
    },
    "ws-build": {
      "description": "Builds code and parses errors",
      "mode": "subagent",
      "temperature": 0,
      "prompt": "You build, parse errors, and only return errors. Focus on building the code base, parsing all errors, returning all errors.",
      "permission": {
        "edit": "deny",
        "read": {
          "~/nixfiles/secrets/*": "deny"
        },
        "bash": {
          "*": "deny",
          "nix-build nixfiles -A pkgs.ros.nova-workspace": "allow",
          "nix-build nixfiles -A pkgs.*": "allow"
        },
        "external_directory": {
          "/nix/store/**": "allow",
          "~/*": "deny"
        }
      }
    },
    "git-commit": {
      "description": "Commits changes to git",
      "mode": "subagent",
      "temperature": 0,
      "prompt": "/git-commit",
      "permission": {
        "edit": "deny",
        "read": {
          "*": "allow",
          "~/nixfiles/secrets/*": "deny"
        },
        "external_directory": {
          "~/*": "deny"
        }
      }
    }
  },
  "mcp": {
    "mcp-nixos": {
      "type": "local",
      "command": ["mcp-nixos"]
    }
  }
}