{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "patch": {
      "description": "Builds code and fixes errors",
      "mode": "primary",
      "temperature": 0.1,
      "prompt": "You get errors from @ws-build, then explain and fix those errors. Focus on explaining and fixing errors.",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "rm *": "deny",
        "external_directory": {
          "/nix/store/**": "allow"
        },
        "skill": {
          "git-commit": "allow"
        }
      }
    },
    "ws-build": {
      "description": "Builds code and parses errors",
      "mode": "subagent",
      "temperature": 0,
      "prompt": "You build, parse errors, and only return errors. Focus on building the code base, parsing all errors, returning all errors.",
      "permission": {
        "edit": "deny",
        "read": {
          "~/": "deny",
          "~/nova/": "allow",
          "~/nova/src/": "deny"
        },
        "bash": {
          "*": "deny",
          "nix-build ~/nova/src/../nixfiles -A pkgs.ros.nova-workspace -o ~/Builds/test": "allow"
        },
        "external_directory": {
          "/nix/store/**": "allow"
        }
      }
    }
  },
  "mcp": {
    "mcp-nixos": {
      "type": "local",
      "command": ["mcp-nixos"]
    }
  }
}