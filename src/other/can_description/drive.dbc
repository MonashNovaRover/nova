VAL_ 1152 error_message 0 "no_steps" 1 "magnetic_encoder_error" 2 "resolver_error" 3 "resolver_failed_checksum" 4 "unexpected_position_command" 5 "gate_driver_fault" 6 "gate_driver_spi_failed" 7 "ma302_spi_failed" 8 "rotor_home_failed" 9 "resolver_zero_failure" 10 "stall_triggered" 11 "over_speed" 12 "over_acceleration" 13 "encoder_fault" ;
VAL_ 1152 log_message 0 "error" 1 "warning" 2 "info" 3 "gate_driver_condition" ;
VAL_ 1161 value 0 "false" 1 "true" ;
VAL_ 1161 configuration 0 "has_resolver" 1 "current_kp" 2 "current_ki" 3 "max_current_threshold" 4 "velocity_kp" 5 "velocity_ki" 6 "max_velocity_threshold" 7 "min_interval" 8 "position_kp" 9 "position_ki" 10 "max_position_threshold" 11 "telemetry_packet_1_speed" 12 "telemetry_packet_2_speed" 13 "telemetry_packet_3_speed" 14 "telemetry_packet_4_speed" ;



