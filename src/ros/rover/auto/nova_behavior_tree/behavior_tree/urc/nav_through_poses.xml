<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <BlackboardPublisher topic_name="blackboard" keys="goals" publish_frequency="1"/>
        <RateController hz="1.0">
          <ReactiveSequence>
            <ForceSuccess>
              <Sequence>
                <RunOnce>
                  <PlaceSearchGoals search_radius="7.0" search_corners="3" input_goals="{goals}" output_goals="{goals}"/>
                </RunOnce>
                <ARTagDetected detections_topic="/aruco_detections" min_detections="2" buffer_time="5.0" cluster_radius="1.5" detections="{detected_goals}"/>
                <GetGoal index="0" input_goals="{detected_goals}" output_goal="{detected_goal}"/>
                <GetCurrentPose current_pose="{current_pose}"/>
                <UpdateURCGoals detected_goal="{detected_goal}" current_pose="{current_pose}" input_goals="{goals}" output_goals="{goals}"/>
              </Sequence>
            </ForceSuccess>
            <Sequence name="ComputeAndSmoothPathThroughPoses">
              <ReactiveSequence>
                <RemoveNearbyInCollisionGoals input_goals="{goals}" max_distance_threshold="4" global_frame="map" robot_base_frame="base_link" cost_threshold="99.0" output_goals="{goals}"/>
                <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="1.0"/>
                <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
              </ReactiveSequence>
              <SmoothPath unsmoothed_path="{path}" smoothed_path="{smoothed_path}" smoother_id="savitzky_golay_smoother"/>
            </Sequence>
          </ReactiveSequence>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{smoothed_path}" controller_id="RotationShimMPPI" goal_checker_id="goal_checker" progress_checker_id="progress_checker"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <Sequence name="GlobalRecovery">
        <Sequence name="ClearingActions">
          <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>