<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      BTCPP_version="4.10">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <GoalDistanceFilter goal="{goal}" max_distance="5" distance=""/>
      <RecoveryNode name="NavigateRecovery" number_of_retries="6">
        <PipelineSequence name="NavigateToGoalAndSpin">
          <BlackboardPublisher topic_name="blackboard" keys="goals" publish_frequency="1"/>
          <RateController hz="1.0">
            <Sequence name="ComputeAndSmoothPath">
              <ComputePathToPose goal="{goal}" start="" planner_id="NavFn" server_name="" server_timeout="" path="{path}" error_code_id=""/>
              <SmoothPath smoother_id="savitzky_golay_smoother" unsmoothed_path="{path}" max_smoothing_duration="" check_for_collisions="" smoothed_path="{smoothed_path}" smoothing_duration="" was_completed=""/>
            </Sequence>
          </RateController>
          <FollowPath controller_id="RotationShimMPPI" path="{smoothed_path}" goal_checker_id="goal_checker" progress_checker_id="progress_checker" service_name="" server_timeout="" error_code_id=""/>
          <Spin spin_dist="3.14" time_allowance="1000.0" server_name="" server_timeout="" error_code_id=""/>
        </PipelineSequence>
        <Sequence name="ClearingActions">
          <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap" server_timeout=""/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap" server_timeout=""/>
        </Sequence>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>

</root>
