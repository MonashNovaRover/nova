<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="auto">
    <include>
      <uri>model://arc_terrain</uri>
    </include>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <shadows>false</shadows>
    </scene>

    <spherical_coordinates>
      <!-- currently gazebo has a bug: instead of outputting lat, long, altitude in ENU
      (x = East, y = North and z = Up) as the default configurations, it's outputting (-E)(-N)U,
      therefore we rotate the default frame 180 so that it would go back to ENU
      see: https://github.com/osrf/gazebo/issues/2022 -->
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>38.408456516</latitude_deg>
      <longitude_deg>-110.790323052</longitude_deg>
      <elevation>1370.0</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0 0 34 0 1.570796 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name='red_cube'>
      <pose>6.5 -6.0 2.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
            <material>
              <ambient>0.5 0.1 0.1 1</ambient>   <!-- Dark red ambient -->
              <diffuse>1 0 0 1</diffuse>         <!-- Pure red under light -->
              <specular>0.2 0.2 0.2 1</specular> <!-- Slight shine -->
              <emissive>0 0 0 1</emissive>       <!-- No self-glow -->
            </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name='blue_cube'>
      <pose>5.5 -4.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
            <material>
                <ambient>0.1 0.1 0.5 1</ambient>   <!-- Dark blue ambient -->
                <diffuse>0 0 1 1</diffuse>         <!-- Pure blue under light -->
                <specular>0.2 0.2 0.2 1</specular> <!-- Slight shine -->
                <emissive>0 0 0 1</emissive>       <!-- No self-glow -->
            </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name='green_cube'>
      <pose>7.5 -2.0 3.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
            <material>
                <ambient>0.1 0.5 0.1 1</ambient>   <!-- Dark green ambient -->
                <diffuse>0 1 0 1</diffuse>         <!-- Pure green under light -->
                <specular>0.2 0.2 0.2 1</specular> <!-- Slight shine -->
                <emissive>0 0 0 1</emissive>       <!-- No self-glow -->
            </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name='white_cube'>
      <pose>3.5 -4.0 2.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
            <material>
                <ambient>0.6 0.6 0.6 1</ambient>   <!-- Light gray ambient -->
                <diffuse>1 1 1 1</diffuse>         <!-- Pure white under light -->
                <specular>0.3 0.3 0.3 1</specular> <!-- Slight shine -->
                <emissive>0 0 0 1</emissive>       <!-- No self-glow -->
            </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
    </model>
    <!--
    <model name='black_cube'>
      <pose>8.5 -2.0 5.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
            <material>
              <ambient>0.05 0.05 0.05 1</ambient>
              <diffuse>0 0 0 1</diffuse>         
              <specular>0 0 0 1</specular>      
              <emissive>0 0 0 1</emissive>       
            </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
    </model>
    -->
    <include>
      <uri>model://ar_tag</uri>
    </include>

  </world>
</sdf>