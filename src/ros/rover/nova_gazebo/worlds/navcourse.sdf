<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="flat">

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane
      </uri>
    </include>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun
      </uri>
      <pose>2 -10 10 0.8 -0.8 0</pose>
    </include>  

    <spherical_coordinates>
      <!-- currently gazebo has a bug: instead of outputting lat, long, altitude in ENU
      (x = East, y = North and z = Up) as the default configurations, it's outputting (-E)(-N)U,
      therefore we rotate the default frame 180 so that it would go back to ENU
      see: https://github.com/osrf/gazebo/issues/2022 -->
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>38.406863</latitude_deg>
      <longitude_deg>-110.791055</longitude_deg>
      <elevation>1370.0</elevation>
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <!-- Obstacle Course designed on 2025-01-10 by Victor and Co (Implemented by Anthony Lew) -->
    <!-- Notes: 
           Poles are not static (Can be moved)
           Goal ball is static and has no collision (Can be used to see how close the planner comes goes into costly areas)
           Corridor is static
    -->
    <!-- Corridor from screenshot x=vertical, y=horizontal (left = pos) 3m squares -->
    <!-- ___top_____
        |________|  | 
        |  |   __|__| right_small
        |  |  |  |
        |  |cc|  |
   left |  |  | right
        |__|  |__|
    -->
    <model name='corridor'>
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name='left'>
        <pose>0 3 0 0 0 0</pose>
        <collision name='collision_left'>
          <geometry>
            <box>
              <size>15 3 1</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual_left'>
          <geometry>
            <box>
              <size>15 3 1</size>
            </box>
          </geometry>
          <material> 
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.45 0.45 0.9 1</diffuse>
            <specular>0 0 0 0</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
      <link name='right'>
        <pose>-1.5 -3 0 0 0 0</pose>
        <collision name='collision_right'>
          <geometry>
            <box>
              <size>12 -3 1</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual_right'>
          <geometry>
            <box>
              <size>12 3 1</size>
            </box>
          </geometry>
          <material> 
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.45 0.45 0.9 1</diffuse>
            <specular>0 0 0 0</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
      <link name='top'>
        <pose>9 0 0 0 0 0</pose>
        <collision name='collision_top'>
          <geometry>
            <box>
              <size>3 9 1</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual_top'>
          <geometry>
            <box>
              <size>3 9 1</size>
            </box>
          </geometry>
          <material> 
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.45 0.45 0.9 1</diffuse>
            <specular>0 0 0 0</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
      <link name='right_small'>
        <pose>7.5 -6 0 0 0 0</pose>
        <collision name='collision_right_small'>
          <geometry>
            <box>
              <size>6 3 1</size>
            </box>
          </geometry>
        </collision>
        <visual name='visual_right_small'>
          <geometry>
            <box>
              <size>6 3 1</size>
            </box>
          </geometry>
          <material> 
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.45 0.45 0.9 1</diffuse>
            <specular>0 0 0 0</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

