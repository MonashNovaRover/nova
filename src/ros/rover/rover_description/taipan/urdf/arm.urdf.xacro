<?xml version="1.0" encoding="utf-8"?>
<!-- Generated using onshape-to-robot -->
<robot name="arm"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="rover_description_dir" default="$(find rover_description)" />
  <xacro:arg name="ducket" default="true"/>

  <xacro:include filename="$(arg rover_description_dir)/taipan/urdf/arm.urdf"/>

  <xacro:if value="$(arg ducket)">
    <xacro:include filename="$(arg rover_description_dir)/ducket/ducket.urdf.xacro"/>
    <joint name="armbox_to_ducket" type="fixed">
        <origin xyz="-0.0354798 -0.151628 -0.122841" rpy="-7.71583e-15 8.81621e-38 -4.38974e-37" />
        <axis xyz="0 -0.707107 -0.707107" />
        <parent link="arm_box" />
        <child link="ducket_link" />
    </joint>
  </xacro:if>

  <!-- Kinematics -->
  <!-- THESE NEED FIXING 4/02/2026 !!! -->
  <!-- Origin of arm for IK. Should align with J1, but not -->
  <link name="arm_kinematics_origin"/>
  <joint name="arm_kinematics_origin_joint" type="fixed">
    <origin xyz="0.0 0.0 0.196" rpy="0.0 0.0 -1.57079632679" />
    <parent link="arm_link" />
    <child link="arm_kinematics_origin" />
  </joint>
  <!-- Origin of arm for IK -->

  <link name="endeffector_kinematics"/>
  <joint name="endeffector_kinematics_joint" type="fixed">
    <!-- before rotating to match IK function expected 0: 1.5707963 0.0 1.5707963 -->
    <origin xyz="0.0 0.0 -0.2225" rpy="0.0 1.5707963 1.833" />
    <parent link="ee_base" />
    <child link="endeffector_kinematics" />
  </joint>
  <!--    z at 1.2321-->

  <!--    1.0232 0.012512 1.2183-->

  <!--    up 0.0138-->
  <!--    forward 0.012512-->


  <!-- Linear actuator tip frame for auto-typing -->
  <link name="actuator"/>
  <joint name="actuator_tip_joint" type="fixed">
    <origin xyz="0 0 -0.016" rpy="3.14159 0 1.5707"/>
    <parent link="linear_actuator"/>
    <child link="actuator"/>
  </joint>

  <!-- Periscope camera frame for auto-typing -->
  <link name="image_frame"/>
  <joint name="camera_ee_finger" type="fixed">
    <origin xyz="-0.063 0 0.017" rpy="3.14159 0 -1.5707"/>
    <parent link="linear_actuator"/>
    <child link="image_frame"/>
  </joint>

  <!-- Gazebo / IRL Control -->
  <xacro:include filename="$(arg rover_description_dir)/taipan/urdf/arm_ckc.xacro"/>

  <xacro:if value="$(arg gazebo)">
    <xacro:include filename="$(arg rover_description_dir)/taipan/urdf/arm.gz_ros2_control.xacro" />
    <xacro:include filename="$(arg rover_description_dir)/taipan/urdf/arm_sensors.xacro"/>
  </xacro:if>
  <xacro:unless value="$(arg gazebo)">
    <xacro:include filename="$(arg rover_description_dir)/taipan/urdf/arm.ros2_control.xacro" />
    <xacro:arm_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>
  </xacro:unless>

</robot>
