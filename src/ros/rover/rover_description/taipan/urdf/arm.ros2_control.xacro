		<xacro:unless value="${use_mock_hardware}">
			<ros2_control name="arm_la_prismatic" type="system">
					<hardware>
						<plugin>qcmd_hardware/QCMDHardware</plugin>
						<param name="candevice">can1</param> 
						<param name="canid">0C1</param> 
						<param name="max_effort">1</param>
					</hardware>
				<xacro:if value="${use_mock_hardware}">
					<hardware>
						<plugin>mock_components/GenericSystem</plugin>
						<param name="calculate_dynamics">true</param>
					</hardware>
				</xacro:if>

				<joint name="la_prismatic">
					<command_interface name="velocity">
					<param name="max">1</param>
					</command_interface>

					<state_interface name="velocity">
					<param name="initial_value">0.0</param>
					</state_interface>
				</joint>
			</ros2_control>
		</xacro:unless>


	<xacro:unless value="${use_mock_hardware}">

		<ros2_control name="arm_lead_left" type="system">
			<hardware>
				<plugin>qcmd_hardware/QCMDHardware</plugin>
				<param name="candevice">can1</param> 
				<param name="canid">0D1</param>
				<param name="max_effort">1</param>
			</hardware>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<joint name="lead_left">
				<command_interface name="velocity">
					<param name="max">1</param>
				</command_interface>

				<state_interface name="velocity">
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>
	</xacro:unless>


	</xacro:macro>
</robot>
