<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Test trying to make a ros2_control URDF for the new arm -->
	<!-- Initial definition based on https://github.com/xArm-Developer/xarm_ros2/blob/master/xarm_description/urdf/xarm6/xarm6.ros2_control.xacro -->

	<xacro:macro name="arm_ros2_control" params="use_mock_hardware">

		<ros2_control name="arm_J1" type="system">
			<xacro:unless value="${use_mock_hardware}">
				<hardware>
					<plugin>blcmd_hardware2/BLCMDHardware</plugin>
					<param name="candevice">can1</param>
					<param name="canid">1</param>
					<param name="resolver_reduction">4</param>
					<param name="clock_rate">100000000</param>
					<param name="revolution_pulses">8192</param>
					<param name="min_interval">233</param>
					<param name="gear_ratio">100.0</param>
					<param name="mock">true</param>
					<param name="reversed">false</param>
					<param name="integrate_velocity">false</param>
          <param name="res_ticks_per_rev">4096</param> <!-- 0x1000 is proportional to 2pi -->
          <param name="zero_offset">8192</param> <!-- electrical's "home" is 0x2000 -->
				</hardware>
			</xacro:unless>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<!--
	  <hardware>
        TODO: Figure out and add the Hardware interface
	  <plugin>${ros2_control_plugin}</plugin>
	  </hardware>
	  -->

			<joint name="j1">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="max">1.0</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_J2" type="system">
			<xacro:unless value="${use_mock_hardware}">
				<hardware>
					<plugin>blcmd_hardware2/BLCMDHardware</plugin>
					<param name="candevice">can1</param>
					<param name="canid">2</param>
					<param name="resolver_reduction">5.375</param>
					<param name="clock_rate">100000000</param>
					<param name="revolution_pulses">8192</param>
					<param name="min_interval">233</param>
					<param name="gear_ratio">100.0</param>
					<param name="mock">true</param>
					<param name="reversed">false</param>
					<param name="integrate_velocity">false</param>
          <param name="res_ticks_per_rev">4096</param> <!-- 0x1000 is proportional to 2pi -->
          <param name="zero_offset">7792</param> <!-- electrical's "home" is 0x2000 -->
				</hardware>
			</xacro:unless>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<joint name="j2">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_J3" type="system">
			<xacro:unless value="${use_mock_hardware}">
				<hardware>
					<plugin>blcmd_hardware2/BLCMDHardware</plugin>
					<param name="candevice">can1</param>
					<param name="canid">3</param>
					<param name="resolver_reduction">5.375</param>
					<param name="clock_rate">100000000</param>
					<param name="revolution_pulses">8192</param>
					<param name="min_interval">233</param>
					<param name="gear_ratio">100.0</param>
					<param name="mock">true</param>
					<param name="reversed">true</param>
					<param name="integrate_velocity">false</param>
          <param name="res_ticks_per_rev">4096</param> <!-- 0x1000 is proportional to 2pi -->
          <param name="zero_offset">8210</param> <!-- electrical's "home" is 0x2000 -->
				</hardware>
			</xacro:unless>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<joint name="j3">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_J4" type="system">
			<xacro:unless value="${use_mock_hardware}">
				<hardware>
					<plugin>blcmd_hardware2/BLCMDHardware</plugin>
					<param name="candevice">can1</param>
					<param name="canid">4</param>
					<param name="resolver_reduction">4</param>
					<param name="clock_rate">100000000</param>
					<param name="revolution_pulses">8192</param>
					<param name="min_interval">122</param>
					<param name="gear_ratio">8.0</param>
					<param name="mock">true</param>
					<param name="reversed">true</param>
					<param name="integrate_velocity">false</param>
          <param name="res_ticks_per_rev">4096</param> <!-- 0x1000 is proportional to 2pi -->
          <param name="zero_offset">8192</param> <!-- electrical's "home" is 0x2000 -->
				</hardware>
			</xacro:unless>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<joint name="j4">
				<command_interface name="velocity">
				</command_interface>
				<command_interface name="position">
				</command_interface>
				<state_interface name="velocity">
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_diff_wrist" type="system">
			<xacro:unless value="${use_mock_hardware}">
				<hardware>
					<plugin>blcmd_hardware2/BLCMDHardware</plugin>
					<param name="candevice">can1</param>
					<param name="canid">5 6</param>
					<param name="resolver_reduction">1.25</param>
					<param name="clock_rate">100000000</param>
					<param name="revolution_pulses">8192</param>
          <param name="min_interval">122</param>
					<param name="gear_ratio">10.0</param>
					<param name="mock">true</param>
					<param name="reversed">false</param>
					<param name="integrate_velocity">false</param>
					<param name="res_ticks_per_rev">4096</param> <!-- 0x1000 is proportional to 2pi -->
					<param name="zero_offset">7785</param> <!-- electrical's "home" is 0x2000 -->
					<param name="diff_wrist">true</param>
				</hardware>
			</xacro:unless>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<joint name="j5">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>

			<joint name="j6">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>

			<transmission name="diff_wrist_transmission">
				<plugin>transmission_interface/DifferentialTransmission</plugin>
				<actuator name="diff_wrist_pitch" role="actuator1"/>
				<actuator name="diff_wrist_yaw" role="actuator2"/>
				<joint name="j5" role="joint1"/>
				<joint name="j6" role="joint2"/>
			</transmission>
		</ros2_control>

