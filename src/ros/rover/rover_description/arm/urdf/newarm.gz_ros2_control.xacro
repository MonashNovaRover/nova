  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find auto_bringup)/params/controllers.yaml</parameters>
    </plugin>
  </gazebo>


