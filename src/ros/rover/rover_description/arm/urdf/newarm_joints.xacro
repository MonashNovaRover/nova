<?xml version="1.0" encoding="utf-8"?>
<!-- publish joints for arm -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
     <gazebo>
          <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
               <topic>arm_joints</topic>
               <joint_name>J1</joint_name>
               <joint_name>J2</joint_name>
               <joint_name>J3</joint_name>
               <joint_name>J4</joint_name>
               <joint_name>J5</joint_name>
               <joint_name>J6</joint_name>
               
               <joint_name>wrist_pitch</joint_name>
               <joint_name>wrist_yaw</joint_name>
               <joint_name>wrist_roll</joint_name>

               <joint_name>rf_slide</joint_name>
               <joint_name>lf_slide</joint_name>
               <joint_name>actuator_head</joint_name>
          </plugin>
     </gazebo>
</robot>
