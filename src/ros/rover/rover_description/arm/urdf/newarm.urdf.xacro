    <!-- <xacro:include filename="newarm_ckc.xacro"/> -->

    <!-- gazebo parameters-->
    <gazebo>
    </gazebo>
    
    <!--xacro:include filename="arm_odom.xacro"/ -->
    <!-- <xacro:if value="$(arg gazebo)">
        <xacro:include filename="$(arg rover_description_dir)/arm/urdf/newarm.ros2_control.xacro" />
    </xacro:if> -->


    <!-- gz start -->

    <xacro:unless value="$(arg gazebo)">
        <!-- not gazebo start -->
        <xacro:include filename="$(arg rover_description_dir)/arm/urdf/newarm.ros2_control.xacro" />
        <!-- not gazebo middle -->
        <xacro:newarm_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>
        <!-- not gazebo end -->
    </xacro:unless>

    <!-- gz middle -->

    <xacro:if value="$(arg gazebo)">
        <!-- heehee gazebo start -->
        <!-- <xacro:include filename="$(arg rover_description_dir)/arm/urdf/newarm.gz_ros2_control.xacro" /> -->
        <!-- hahah gazebo end -->
    </xacro:if>
    <!-- gz end -->

    <!-- Standalone arm definition -->
    <xacro:unless value="$(arg arm)">
        <link name="base_link"></link>
        <joint name="base_link_to_chassis" type="fixed">
            <parent link="base_link"/>
            <child link="chassis" />
            <origin rpy="0.0 0 0" xyz="0 0 0.07"/>
        </joint>
        <!-- Chassis for standalone arm -->
        <link name="chassis">
            <visual>
                <origin xyz="0 0 0" rpy="0 -0 1.570796326794896558" />
                <geometry>
                    <mesh filename="file://$(arg rover_description_dir)/base/meshes/chassis.stl"/>
                </geometry>
                <material name="chassis_material">
                    <color rgba="0.86666666666666669627 0.074509803921568626417 0.32549019607843138191 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 -0 1.570796326794896558" />
                <geometry>
                    <mesh filename="file://$(arg rover_description_dir)/base/meshes/chassis.stl"/>
                </geometry>
            </collision>
            <inertial>
                <origin xyz="-0.022980723180786852278 -0.00012909338240177009919 0.024515364506931154598" rpy="0 0 0"/>
                <mass value="8.3419541100883822793" />
                <inertia ixx="0.21737687093594909582" ixy="0.00013546851964914204689" ixz="-0.0088627259627339256831" iyy="0.45541406320296262678" iyz="-0.00021657327861208234047" izz="0.59726536058024171094" />
            </inertial>
        </link>

        <joint name="J1" type="revolute">
            <origin xyz="0.22899999999999565148 1.1102230246251564172e-16 0.11707476398169122667" rpy="-3.141592653589793116 -1.3309679851047901909e-16 0" />
            <parent link="chassis" />
            <child link="gearbox" />
            <axis xyz="0 0 1"/>
            <limit effort="1" velocity="1" lower="-3.141592653589793116" upper="3.141592653589793116"/>
            <joint_properties damping="20.0" friction="0.1"/>
        </joint>

        <!-- Origin of arm for IK. Should align with J1, but not -->
        <link name="arm_kinematics_origin"/>
        <joint name="arm_kinematics_origin_joint" type="fixed">
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <parent link="chassis" />
            <child link="arm_kinematics_origin" />
        </joint>
        <!-- Origin of arm for IK -->

        <xacro:include filename="newarm_joints.xacro"/>
    </xacro:unless>
    <xacro:if value="$(arg arm)">
        <!-- Origin of arm for IK. Should align with J1, but not -->
        <link name="arm_kinematics_origin"/>
        <joint name="arm_kinematics_origin_joint" type="fixed">
            <origin xyz="0.22899999999999565148 1.1102230246251564172e-16 0.28205202431" rpy="0.0 0.0 0.0" />
            <parent link="chassis" />
            <child link="arm_kinematics_origin" />
        </joint>
        <!-- Origin of arm for IK -->

    </xacro:if>

    <link name="endeffector_kinematics"/>
    <joint name="endeffector_kinematics_joint" type="fixed">
        <!-- before rotating to match IK function expected 0: 1.5707963 0.0 1.5707963 -->
        <origin xyz="0.0138 0.0 -0.012512" rpy="1.5707963 0.0 1.5707963" />
        <parent link="endeffector" />
        <child link="endeffector_kinematics" />
    </joint>

