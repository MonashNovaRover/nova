			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<joint name="J3">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_J4" type="system">
			<xacro:unless value="${use_mock_hardware}">
				<hardware>
					<plugin>blcmd_hardware2/BLCMDHardware</plugin>
					<param name="candevice">can1</param>
					<param name="canid">4</param>
					<param name="resolver_reduction">15</param>
					<param name="clock_rate">100000000</param>
					<param name="revolution_pulses">8192</param>
					<param name="min_interval">1728</param>
					<param name="gear_ratio">15.0</param>
					<param name="mock">true</param>
					<param name="reversed">true</param>
					<param name="integrate_velocity">true</param>
					<param name="max_position">12.5663706144</param>
					<param name="position_offset">0.0</param>
					<param name="max_velocity">19.4963194091</param>
				</hardware>
			</xacro:unless>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
