<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Test trying to make a ros2_control URDF for the new arm -->
	<!-- Initial definition based on https://github.com/xArm-Developer/xarm_ros2/blob/master/xarm_description/urdf/xarm6/xarm6.ros2_control.xacro -->

	<xacro:macro name="arm_ros2_control" params="use_mock_hardware">

		<ros2_control name="arm_J1" type="system">
			<xacro:unless value="${use_mock_hardware}">
				<hardware>
					<plugin>blcmd_hardware2/BLCMDHardware</plugin>
					<param name="candevice">can1</param>
					<param name="canid">1</param>
					<param name="resolver_reduction">4</param>
					<param name="gear_ratio">100.0</param>
					<param name="reversed">false</param>
					<param name="max_position">12.56637</param>
          <param name="position_offset">-3.1416885303149615</param> <!-- electrical's home is 0x2000 -->
					<param name="max_velocity">2.3</param>
				</hardware>
			</xacro:unless>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<!--
	  <hardware>
        TODO: Figure out and add the Hardware interface
	  <plugin>${ros2_control_plugin}</plugin>
	  </hardware>
	  -->

			<joint name="J1">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="max">1.0</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_J2" type="system">
			<xacro:unless value="${use_mock_hardware}">
				<hardware>
					<plugin>blcmd_hardware2/BLCMDHardware</plugin>
					<param name="candevice">can1</param>
					<param name="canid">2</param>
					<param name="resolver_reduction">5.375</param>
					<param name="gear_ratio">100.0</param>
					<param name="reversed">true</param>
					<param name="max_position">12.56637</param>
          <param name="position_offset">4.448680047809272</param> <!-- right angle is 0x2d50 -->
					<param name="max_velocity">1.740138699</param>
				</hardware>
			</xacro:unless>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<joint name="J2">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_J3" type="system">
			<xacro:unless value="${use_mock_hardware}">
				<hardware>
					<plugin>blcmd_hardware2/BLCMDHardware</plugin>
					<param name="candevice">can1</param>
					<param name="canid">3</param>
					<param name="resolver_reduction">5.375</param>
					<param name="gear_ratio">100.0</param>
					<param name="reversed">false</param>
					<param name="max_position">12.56637</param>
          <param name="position_offset">-3.1416885303149615</param> <!-- electrical's home is 0x2000 XXX THIS IS WRONG, elec's home is not right angle -->
					<param name="max_velocity">1.740138699</param>
				</hardware>
			</xacro:unless>
			<xacro:if value="${use_mock_hardware}">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>
			</xacro:if>

			<joint name="J3">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_J4" type="system">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>

			<joint name="J4">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_J5" type="system">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>

			<joint name="J5">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="max">12.5663706144</param>
					<param name="initial_value">0.0</param>
				</state_interface>
			</joint>
		</ros2_control>

		<ros2_control name="arm_J6" type="system">
				<hardware>
					<plugin>mock_components/GenericSystem</plugin>
					<param name="calculate_dynamics">true</param>
				</hardware>

			<joint name="J6">
				<command_interface name="velocity">
					<param name="max">292.444791137</param>
				</command_interface>
				<command_interface name="position">
					<param name="max">12.5663706144</param>
				</command_interface>
				<state_interface name="velocity">
					<param name="max">292.444791137</param>
					<param name="initial_value">0.0</param>
				</state_interface>
				<state_interface name="position">
					<param name="initial_value">0.0</param>
					<param name="max">12.5663706144</param>
				</state_interface>
			</joint>
		</ros2_control>

	 <ros2_control name="arm_actuator_head" type="system">
			<hardware>
				<plugin>mock_components/GenericSystem</plugin>
				<param name="calculate_dynamics">true</param>
			</hardware>

		<joint name="actuator_head">
			<command_interface name="velocity">
			<param name="max">1</param>
			</command_interface>

			<state_interface name="velocity">
			<param name="initial_value">0.0</param>
			</state_interface>
		</joint>
	</ros2_control>


