  <ros2_control name="arm_left_slide" type="system">
		<xacro:unless value="${use_mock_hardware}">
			<hardware>
				<plugin>qcmd_hardware/QCMDHardware</plugin>
				<param name="candevice">can1</param> 
				<param name="canid">0D1</param> <!-- TODO: Get CAN id, resolver id should be that *4 -->
				<!-- <param name="resolver_id">344</param>
				<param name="resolver_reduction">1.0</param>
				<param name="reversed">false</param>
