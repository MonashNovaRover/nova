  <joint name="l1b_bp" type="continuous">
    <origin xyz="-0.1 4.09117e-14 1.53793e-15" rpy="-9.81009e-23 -1.49984e-14 3.14159" />
    <parent link="l2prime" />
    <child link="l1prime" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" />
  </joint>

  <joint name="J3" type="revolute">
    <origin xyz="8.91995e-15 9.91018e-16 -0.076" rpy="-1.5708 -4.53153e-29 -1.5708" />
    <parent link="linkagedrive" />
    <child link="l2prime" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" lower="-3.141592653589793" upper="3.141592653589793" />
