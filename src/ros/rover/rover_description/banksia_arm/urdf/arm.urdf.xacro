  <link name="l2cam">
    <inertial>
      <origin xyz="-9.6159014164e-19 4.7181909533e-02 5.3580982436e-01" rpy="0 0 0" />
      <mass value="0.0452512" />
      <inertia ixx="3.7348168434e-05" ixy="-6.8623910238e-22" ixz="-6.8299173640e-20" iyy="1.4674096352e-05" iyz="-1.3816530174e-05" izz="2.3754128787e-05" />
