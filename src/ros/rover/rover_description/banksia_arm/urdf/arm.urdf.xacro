  <joint name="base_to_gearbox" type="fixed">
    <origin xyz="0 0 0.003" rpy="-3.14159 1.88173e-16 -2.61008e-22" />
    <parent link="armmount" />
    <child link="gearbox" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" />
  </joint>

  <joint name="arm_link_to_armmount" type="fixed">
    <origin xyz="0 0 0" rpy="0 -0 0" />
    <parent link="arm_link" />
    <child link="armmount" />
  </joint>

  <!-- Kinematics -->
  <!-- Origin of arm for IK. Should align with J1, but not -->
  <link name="arm_kinematics_origin"/>
  <joint name="arm_kinematics_origin_joint" type="fixed">
    <origin xyz="0.0 0.0 0.196" rpy="0.0 0.0 -1.57079632679" />
    <parent link="armmount" />
    <child link="arm_kinematics_origin" />
  </joint>
  <!-- Origin of arm for IK -->

  <link name="endeffector_kinematics"/>
  <joint name="endeffector_kinematics_joint" type="fixed">
    <!-- before rotating to match IK function expected 0: 1.5707963 0.0 1.5707963 -->
    <origin xyz="0.0067503 -0.0012 0.2225" rpy="-1.57079632679 -1.57079632679 0.0" />
    <parent link="eebase" />
    <child link="endeffector_kinematics" />
  </joint>
  <!--    z at 1.2321-->

  <!--    1.0232 0.012512 1.2183-->

  <!--    up 0.0138-->
  <!--    forward 0.012512-->

  <!-- Gazebo / IRL Control -->
  <xacro:include filename="$(find rover_description)/banksia_arm/urdf/arm_ckc.xacro"/>

  <xacro:if value="$(arg gazebo)">
    <xacro:include filename="$(find rover_description)/banksia_arm/urdf/arm.gz_ros2_control.xacro" />
    <xacro:include filename="$(find rover_description)/banksia_arm/urdf/arm_sensors.xacro"/>
  </xacro:if>
  <xacro:unless value="$(arg gazebo)">
    <xacro:include filename="$(find rover_description)/banksia_arm/urdf/arm.ros2_control.xacro" />
    <xacro:arm_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>
  </xacro:unless>

</robot>