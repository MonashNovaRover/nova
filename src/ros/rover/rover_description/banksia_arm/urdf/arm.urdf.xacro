  <joint name="J1" type="continuous">
    <origin xyz="-2.45166e-16 -1.77636e-15 -0.062" rpy="3.14159 -0 -7.70285e-39" />
    <parent link="gearbox" />
    <child link="linkagedrive" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" />
