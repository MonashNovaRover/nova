  <joint name="l1b_tp" type="continuous">
    <origin xyz="3.05311e-16 -0.5 5.77479e-16" rpy="-1.0988e-15 4.62615e-16 0.648016" />
    <parent link="l1prime" />
    <child link="l2cam" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" />
  </joint>

  <joint name="l1b_bp" type="continuous">
    <origin xyz="0.0797283 -0.0603606 -0.006" rpy="-1.08371e-22 -4.6005e-22 -0.648016" />
    <parent link="l2prime" />
    <child link="l1prime" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" />
  </joint>

  <joint name="J3" type="revolute">
    <origin xyz="-0.006 -1.43816e-09 0.131" rpy="-1.5708 0.648016 1.5708" />
    <parent link="linkagedrive" />
    <child link="l2prime" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="10" lower="-3.141592653589793" upper="3.141592653589793" />
