<?xml version="1.0" encoding="utf-8"?>
<!-- publish joints for arm -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
     <xacro:arg name="prefix" default="arm" />
     <gazebo>
          <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
               <topic>arm_joints</topic>
               <joint_name>$(arg prefix)_j1</joint_name>
               <joint_name>$(arg prefix)_j2</joint_name>
               <joint_name>$(arg prefix)_j3</joint_name>
               <joint_name>$(arg prefix)_j4</joint_name>
               <joint_name>$(arg prefix)_j5</joint_name>
               <joint_name>$(arg prefix)_j6</joint_name>
          </plugin>
     </gazebo>
</robot>