<?xml version="1.0" encoding="utf-8"?>
<!-- Generated using onshape-to-robot and modified to include CKCs and ball joints by Anthony Lew -->
<!-- Collisions added using openscad (see .scad files)-->
<!-- Note: Rover pivots' z axis has been inverted to correct for pivot_drive_controller's zero angle.
           Therefore if exported from onshape, don't forget to add a negative sign to the z of the axis tag on each pivot 
     Note 2: Exporting from onshape has _continuous at the end of continuous joint names these have been removed post-export -->
<robot name="Banksia"  xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- Loading args -->
    <xacro:arg name="gazebo" default="false"/>
    <xacro:arg name="use_mock_hardware" default="false"/>
    <xacro:arg name="arm" default="false"/>
    <xacro:arg name="auto_camera" default="true"/>
    <xacro:arg name="robot_name" default="Banksia"/>
    <xacro:arg name="angle" default="0"/>
    <xacro:arg name="use_local_mesh" default="false"/>

    <!-- Robot properties-->
    <gazebo>
        <self_collide>false</self_collide>
    </gazebo>

    <!-- Variables -->
    <xacro:if value="$(arg use_local_mesh)">
        <xacro:property name="mesh_path" value="file://home/nova/nova/src/ros/rover/rover_description" />
    </xacro:if>
    <xacro:unless value="$(arg use_local_mesh)">
        <xacro:property name="mesh_path" value="file://$(find rover_description)" />
    </xacro:unless>
    <xacro:property name="angle" value="$(arg angle)" />

    <!-- Generated URDF -->
    <link name="base_link"></link>

