    <!-- End of Generated URDF -->
    <!-- Include additional xacro files-->
    <xacro:include filename="$(find rover_description)/banksia/urdf/ckc.xacro"/>

    <xacro:if value="$(arg auto_camera)">
        <xacro:include filename="$(find rover_description)/auto_mount/urdf/auto_camera.xacro"/>
    </xacro:if>
    
    <xacro:if value="$(arg arm)">
        <!-- Waratah's arm
        <xacro:include filename="$(find rover_description)/waratah_arm/urdf/arm.urdf.xacro" />
        <joint name="chassis_to_arm_base" type="fixed">
            <origin xyz="0.2 0 -0.06" rpy="0 0 0"/>
            <parent link="chassis" />
            <child link="arm_link" />
        </joint> -->
        <!-- Banksia's arm -->
        <xacro:include filename="$(find rover_description)/banksia_arm/urdf/arm.urdf.xacro" />
        <joint name="chassis_to_arm_base" type="fixed">
            <origin xyz="0.234 -0.001 0.116750" rpy="0 0 1.5708"/>
            <parent link="chassis" />
            <child link="arm_link" />
        </joint>
        <xacro:include filename="$(find rover_description)/banksia_arm/urdf/joint_states_with_arm.xacro"/>
    </xacro:if>
     <xacro:unless value="$(arg arm)">
        <xacro:include filename="$(find rover_description)/banksia/urdf/joint_states.xacro"/>
    </xacro:unless>

    <xacro:unless value="$(arg gazebo)">
        <xacro:include filename="$(find rover_description)/banksia/urdf/ros2_control.xacro" />
        <xacro:rover_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>
    </xacro:unless>

    <xacro:if value="$(arg gazebo)">
        <xacro:include filename="$(find rover_description)/banksia/urdf/gz_ros2_control.xacro" />
    </xacro:if>

    <xacro:include filename="$(find rover_description)/banksia/urdf/p3d.xacro"/>
    <xacro:include filename="$(find rover_description)/banksia/urdf/odom.xacro"/>
    <xacro:include filename="$(find rover_description)/banksia/urdf/gps.xacro"/>
    <xacro:include filename="$(find rover_description)/banksia/urdf/joint_states.xacro"/>
</robot>