<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="GazeboSimSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name='flw'>
      <command_interface name="velocity">
        <param name="min">-50</param>
        <param name="max">50</param>
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name='blw'>
      <command_interface name="velocity">
        <param name="min">-50</param>
        <param name="max">50</param>
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name='frw'>
      <command_interface name="velocity">
        <param name="min">-50</param>
        <param name="max">50</param>
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name='brw'>
      <command_interface name="velocity">
        <param name="min">-50</param>
        <param name="max">50</param>
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="flp">
      <command_interface name="position">
        <param name="min">-${pi}</param>
        <param name="max">${pi}</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-${pi}</param>
        <param name="max">${pi}</param>
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="blp">
      <command_interface name="position">
        <param name="min">-${pi}</param>
        <param name="max">${pi}</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-${pi}</param>
        <param name="max">${pi}</param>
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="frp">
      <command_interface name="position">
        <param name="min">-${pi}</param>
        <param name="max">${pi}</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-${pi}</param>
        <param name="max">${pi}</param>
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="brp">
      <command_interface name="position">
        <param name="min">-${pi}</param>
        <param name="max">${pi}</param>
      </command_interface>
      <command_interface name="velocity">
        <param name="min">-${pi}</param>
        <param name="max">${pi}</param>
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="J1">
      <command_interface name="velocity">
        <param name="max">1</param>
      </command_interface>

      <command_interface name="position">
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="J2">
      <command_interface name="velocity">
        <param name="max">1</param>
      </command_interface>

      <command_interface name="position">
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="J3">
      <command_interface name="velocity">
        <param name="max">1</param>
      </command_interface>

      <command_interface name="position">
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

