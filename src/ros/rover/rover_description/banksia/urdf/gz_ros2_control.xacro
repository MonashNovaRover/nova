		</state_interface>
      </joint>

	  <joint name="l1a_tp">
		<command_interface name="velocity">
		  <param name="max">1</param>
		</command_interface>

		<state_interface name="velocity">
		  <param name="initial_value">0.0</param>
		</state_interface>

		<state_interface name="position"> 
		  <param name="initial_value">0.0</param>
		</state_interface>
      </joint> -->

    <joint name="J4">
      <command_interface name="velocity">
        <param name="max">1</param>
      </command_interface>

      <command_interface name="position">
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>

    <joint name="J5">
      <command_interface name="velocity">
        <param name="max">1</param>
      </command_interface>

      <command_interface name="position">
      </command_interface>

      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
