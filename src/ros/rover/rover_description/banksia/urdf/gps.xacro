<?xml version="1.0" encoding="utf-8"?>
<!--This is a file for the gps plugin for the rover in gazebo. This file is referenced at the bottom of rover.urdf.xacro, 
which is how it gets added to the gazebo sim. Author/s: Dylan Gonzalez-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
  <link name="gps">
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="gps">
    <sensor name="gps_rover" type="navsat">
      <topic>gps</topic>
      <plugin 
        filename="gz-sim-navsat-system" 
        name="gz::sim::systems::NavSat">
      </plugin>
      <gz_frame_id>gps</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <gps>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </vertical>
        </position_sensing>
        <velocity_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0</stddev>
            </noise>
          </vertical>
        </velocity_sensing>
      </gps>
    </sensor>
  </gazebo>
</robot>
