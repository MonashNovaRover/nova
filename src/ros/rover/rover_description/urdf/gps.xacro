<?xml version="1.0" encoding="utf-8"?>
<!--This is a file for the gps plugin for the rover in gazebo. This file is referenced at the bottom of rover.urdf.xacro, 
which is how it gets added to the gazebo sim. Author/s: Dylan Gonzalez-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
  <link name="gps_link" />

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0.04 -0.26 0.614"/> <!-- copied from imu.xacro -->
  </joint>

  <gazebo reference="gps_link">
    <sensor name="skytraq_gps" type="gps">
      <plugin filename="libgazebo_ros_gps_sensor.so" name="gps_plugin">
        <ros>
          <remapping>~/out:=~/gps/fix</remapping>
        </ros>
      </plugin>

      <always_on>true</always_on>
      <update_rate>1</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <gps>
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </gps>
    </sensor>
  </gazebo>
</robot>
