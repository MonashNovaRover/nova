<?xml version="1.0" encoding="utf-8"?>
<!-- Handle custom joints that are not supported by gazebo -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!-- Ball joint for tr_difflink-->
    <!-- Intermediate link 1 -->
    <link name="tr_difflink_1">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- Intermediate link 2 -->
    <link name="tr_difflink_2">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- Roll Joint -->
    <joint name="tr_difflink_roll" type="revolute">
        <parent link="diffbar"/>
        <child link="tr_difflink_1"/>
        <origin xyz="-0.38912669878348532526 0.0080507423534932481823 7.2164496600635175128e-16" rpy="1.8972013954619286746 0.81245706006717677283 -1.1914339028340867888" />
        <axis xyz="1 0 0"/>
        <limit effort="1.0" velocity="2.0" lower="-0.349066" upper="0.349066"/> <!-- +/- 20 degrees -->
        <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Pitch Joint -->
    <joint name="tr_difflink_pitch" type="revolute">
        <parent link="tr_difflink_1"/>
        <child link="tr_difflink_2"/>
        <axis xyz="0 1 0"/>
        <limit effort="1.0" velocity="2.0" lower="-0.349066" upper="0.349066"/> <!-- +/- 20 degrees -->
        <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Yaw Joint -->
    <joint name="tr_difflink_yaw" type="revolute">
        <parent link="tr_difflink_2"/>
        <child link="difflinktop_2"/>
        <axis xyz="0 0 1"/>
        <limit effort="1.0" velocity="2.0" lower="-3.141592654" upper="3.141592654"/>
        <dynamics damping="0.01" friction="0.0"/>
        # attempt to change z axis as it is the axis of rotation for revolute
    </joint>



    <!-- Ball joint for br_difflink-->
    <!-- Intermediate link 1 -->
    <link name="br_difflink_1">
        <inertial>
        <mass value="0.0001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- Intermediate link 2 -->
    <link name="br_difflink_2">
        <inertial>
        <mass value="0.0001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- Roll Joint -->
    <joint name="br_difflink_roll" type="revolute">
        <parent link="difflinkbottom_2"/>
        <child link="br_difflink_1"/>
        <origin xyz="-2.2204460492503130808e-16 -2.2204460492503130808e-16 0.030366069404429846257" rpy="1.3580572734639122512 0.40045540725920980574 1.5193397039318303765" />
        <axis xyz="1 0 0"/>
        <limit effort="1.0" velocity="2.0" lower="-0.349066" upper="0.349066"/> <!-- +/- 20 degrees -->
        <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Pitch Joint -->
    <joint name="br_difflink_pitch" type="revolute">
        <parent link="br_difflink_1"/>
        <child link="br_difflink_2"/>
        <axis xyz="0 1 0"/>
        <limit effort="1.0" velocity="2.0" lower="-0.349066" upper="0.349066"/> <!-- +/- 20 degrees -->
        <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Yaw Joint -->
    <joint name="br_difflink_yaw" type="revolute">
        <parent link="br_difflink_2"/>
        <child link="diffend_2"/>
        <axis xyz="0 0 1"/>
        <limit effort="1.0" velocity="2.0" lower="-3.141592654" upper="3.141592654"/>
        <dynamics damping="0.01" friction="0.0"/>
    </joint>


    <!-- Ball joint for bl_difflink-->
    <!-- Intermediate link 1 -->
    <link name="bl_difflink_1">
        <inertial>
        <mass value="0.0001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- Intermediate link 2 -->
    <link name="bl_difflink_2">
        <inertial>
        <mass value="0.0001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- Roll Joint -->
    <joint name="bl_difflink_roll" type="revolute">
        <parent link="difflinkbottom"/>
        <child link="bl_difflink_1"/>
        <origin xyz="2.7755575615628913511e-16 4.4408920985006261617e-16 0.03036606940442951319" rpy="-1.3819198339232898753 0.4052315082576601335 1.6592791076415036589" />
        <axis xyz="1 0 0"/>
        <limit effort="1.0" velocity="2.0" lower="-0.349066" upper="0.349066"/> <!-- +/- 20 degrees -->
        <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Pitch Joint -->
    <joint name="bl_difflink_pitch" type="revolute">
        <parent link="bl_difflink_1"/>
        <child link="bl_difflink_2"/>
        <axis xyz="0 1 0"/>
        <limit effort="1.0" velocity="2.0" lower="-0.349066" upper="0.349066"/> <!-- +/- 20 degrees -->
        <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Yaw Joint -->
    <joint name="bl_difflink_yaw" type="revolute">
        <parent link="bl_difflink_2"/>
        <child link="diffend"/>
        <axis xyz="0 0 1"/>
        <limit effort="1.0" velocity="2.0" lower="-3.141592654" upper="3.141592654"/>
        <dynamics damping="0.01" friction="0.0"/>
    </joint>



    <!-- Ball joint for tl_difflink-->
    <!-- Intermediate link 1 -->
    <link name="tl_difflink_1">
        <inertial>
        <mass value="0.0001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- Intermediate link 2 -->
    <link name="tl_difflink_2">
        <inertial>
        <mass value="0.0001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <!-- Roll Joint -->
    <joint name="tl_difflink_roll" type="revolute">
        <parent link="diffbar"/>
        <child link="tl_difflink_1"/>
        <origin xyz="0.36851088408476384561 0.12523629853057594019 5.5511151231257827021e-17" rpy="-1.5857491383211548275 0.08564555364187358133 -1.4824560922687248787" />
        <axis xyz="1 0 0"/>
        <limit effort="1.0" velocity="2.0" lower="-0.349066" upper="0.349066"/> <!-- +/- 20 degrees -->
        <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Pitch Joint -->
    <joint name="tl_difflink_pitch" type="revolute">
        <parent link="tl_difflink_1"/>
        <child link="tl_difflink_2"/>
        <axis xyz="0 1 0"/>
        <limit effort="1.0" velocity="2.0" lower="-0.349066" upper="0.349066"/> <!-- +/- 20 degrees -->
        <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Yaw Joint -->
    <joint name="tl_difflink_yaw" type="revolute">
        <parent link="tl_difflink_2"/>
        <child link="difflinktop"/>
        <axis xyz="0 0 1"/>
        <limit effort="1.0" velocity="2.0" lower="-3.141592654" upper="3.141592654"/>
        <dynamics damping="0.01" friction="0.0"/>
    </joint>

    <!-- Cylindrical mate emulation -->
    <!-- Cylindrical joint for br_difflinkeye-->
    <joint name="br_difflinkeye" type="revolute">
        <origin xyz="1.6653345369377348106e-16 -1.1102230246251565404e-16 -0.059499795362094654028" rpy="-3.1415926535897402694 1.3056345544300866556e-14 -1.2925601884114563678" />
        <parent link="difflinkbody_2" />
        <child link="br_difflink_eye" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-3.141592654" upper="3.141592654"/>
        <joint_properties friction="0.0"/>
    </joint>

    <link name="br_difflink_eye">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="br_difflinksocket" type="prismatic">
        <parent link="br_difflink_eye" />
        <child link="difflinkbottom_2" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-0.002" upper="0.002"/>
        <joint_properties friction="0.0"/>
    </joint>

    <!-- Cylindrical joint for tr_difflinkeye-->
    <joint name="tr_difflinkeye" type="revolute">
        <origin xyz="0.030163508761794161073 0.011735637514349694932 2.7755575615628913511e-16" rpy="1.5707963267949009989 -0.18611770882550127126 -1.1997499986779625036" />
        <parent link="difflinktop_2" />
        <child link="tr_difflink_eye" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-3.141592654" upper="3.141592654"/>
        <joint_properties friction="0.0"/>
    </joint>

    <link name="tr_difflink_eye">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="tr_difflinksocket" type="prismatic">
        <parent link="tr_difflink_eye" />
        <child link="difflinkbody_2" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-0.002" upper="0.002"/>
        <joint_properties friction="0.0"/>
    </joint>

    <!-- Cylindrical joint for bl_difflinkeye-->
    <joint name="bl_difflinkeye" type="revolute">
        <origin xyz="-1.1102230246251565404e-16 1.1102230246251565404e-16 -0.059500000000000233258" rpy="3.1415926535897868987 5.0960784183182330152e-15 -2.3408550063658504214" />
        <parent link="difflinkbody" />
        <child link="bl_difflink_eye" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-3.141592654" upper="3.141592654"/>
        <joint_properties friction="0.0"/>
    </joint>

    <link name="bl_difflink_eye">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="bl_difflinksocket" type="prismatic">
        <parent link="bl_difflink_eye" />
        <child link="difflinkbottom" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-0.002" upper="0.002"/>
        <joint_properties friction="0.0"/>
    </joint>

    <!-- Cylindrical joint for tl_difflinkeye-->
    <joint name="tl_difflinkeye" type="revolute">
        <origin xyz="0.030163508747499123697 0.011735637508787977179 -0.004749999999999865441" rpy="-1.5707963267949025532 0.57279739609381175036 1.9418426549118157354" />
        <parent link="difflinktop" />
        <child link="tl_difflink_eye" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-3.141592654" upper="3.141592654"/>
        <joint_properties friction="0.0"/>
    </joint>

    <link name="tl_difflink_eye">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="tl_difflinksocket" type="prismatic">
        <parent link="tl_difflink_eye" />
        <child link="difflinkbody" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-0.002" upper="0.002"/>
        <joint_properties friction="0.0"/>
    </joint>

    <!-- Cylindrical joint for diffbar_joint-->
    <joint name="diffbar_joint" type="revolute">
        <origin xyz="0.018499995185548932103 1.3346709641398613044e-05 0.019800000000001038991" rpy="3.141592653589793116 -6.9464785874916311517e-17 0.15327080924390459882" />
        <parent link="diffmount" />
        <child link="diffbar_joint_slide" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-3.141592654" upper="3.141592654"/>
        <joint_properties friction="0.0"/>
    </joint>

    <link name="diffbar_joint_slide">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="diffbar_joint_socket" type="prismatic">
        <parent link="diffbar_joint_slide" />
        <child link="diffbar" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="2" lower="-0.005" upper="0.0025"/>
        <joint_properties friction="0.0"/>
    </joint>
</robot>