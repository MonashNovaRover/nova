        <limit effort="1" velocity="20" lower="0" upper="0"/>
        <joint_properties friction="0.0"/>
    </joint>

    <!-- Mimic joints -->
    <gazebo>
        <joint name="diffend_right_mimic" type="revolute">
            <pose>5.5511151231257827021e-16 -2.5153490401663702869e-16 -0.025999999999999440226 7.4921148800370546545e-16 -1.7437204613819068896e-16 3.141592653589793116</pose>
            <parent>diffend</parent>
            <child>rightleg_mimic</child>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>0</lower>
                    <upper>0</upper>
                </limit>
                <mimic joint="diffend_right_join" axis="axis">
                    <multiplier>1</multiplier>
