                    <lower>0</lower>
                    <upper>0</upper>
                </limit>
                <mimic joint="diffend_left_join" axis="axis">
                    <multiplier>1</multiplier>
                </mimic>
            </axis>
        </joint>

        <link name="leftleg_mimic">
            <inertial>
                <pose>0.0015090549950636041217 0.0038104460972356187475 -0.054086077114172889657 0 0 0</pose>
