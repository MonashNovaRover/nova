<?xml version="1.0" encoding="utf-8"?>
<!-- Handle mimic joint to fulfill ckc that are not supported by gazebo -->
<!-- Currently not working (dont use) -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!-- Fixed joints to copy (defined as revolute) -->
    <joint name="diffend_right_join" type="revolute">
        <origin xyz="0.51322913856799590171 -0.0036801808159322734783 -0.096139339161865455807" rpy="3.1345741292001880751 -0.24893965379223365053 -3.1398634278821675458" />
        <parent link="rightleg" />
        <child link="diffend_r" />
        <axis xyz="0 0 1"/>
        <limit effort="1" velocity="20" lower="0" upper="0"/>
        <joint_properties friction="0.0"/>
    </joint>

    <joint name="diffend_left_join" type="revolute">
        <origin xyz="0.51322360006348843875 0.0043850296194944109879 -0.096139340154968722096" rpy="-3.1342139227273708713 -0.24892945331051982705 3.1397747501214343657" />
