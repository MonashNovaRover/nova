        </joint>

        <joint name="diffend_left_mimic" type="revolute">
            <pose>-3.3306690738754696213e-16 -2.6714741530042829254e-16 -0.025999999999999579003 -1.1496843059950411327e-15 8.0953243674990787798e-17 -3.141592653589793116</pose>
