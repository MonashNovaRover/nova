<?xml version="1.0" encoding="utf-8"?>
<!--This is a file for the depth camera plugin for the rover in gazebo. This file is referenced at the bottom of rover.urdf.xacro, 
which is how it gets added to the gazebo sim. Author/s: Victor Bartlinski-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >


  <link name='camera_link'></link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.49 0 0.48" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="camera_link" />
  </joint>

  <xacro:include filename="$(find depthai_descriptions)/urdf/include/depthai_macro.urdf.xacro"/>
  <xacro:depthai_camera camera_name = "oak" parent = "camera_link" camera_model = "OAK-D-LR"
   base_frame = "oak-d_frame" cam_pos_x = "0.0" cam_pos_y = "0.0" cam_pos_z = "0.0" 
   cam_roll = "0.0" cam_pitch = "0.0" cam_yaw = "0.0"/>

  <gazebo reference="oak_rgb_camera_frame">
    <sensor type="depth" name="oak">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>5</update_rate>
      <camera>
        <horizontal_fov>${radians(82)}</horizontal_fov>
        <image>
          <width>600</width>
          <height>400</height>
          <format>B8G8R8</format>
        </image>
        <clip>
          <near>0.4</near>
          <far>100.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <frame_name>oak_rgb_camera_optical_frame</frame_name>
            <ros>
              <remapping>/oak/image_raw:=/oak/rgb/image_raw</remapping>
              <remapping>/oak/image_raw/compressed:=/oak/rgb/image_raw/compressed</remapping>
              <remapping>/oak/image_raw/compressedDepth:=/oak/rgb/image_raw/compressedDepth</remapping>
              <remapping>/oak/image_raw/theora:=/oak/rgb/image_raw/theora</remapping>
              <remapping>/oak/camera_info:=/oak/rgb/camera_info</remapping>
              <remapping>/oak/depth/image_raw:=/oak/stereo/image_raw</remapping>
              <remapping>/oak/depth/image_raw/compressed:=/oak/stereo/image_raw/compressed</remapping>
              <remapping>/oak/depth/image_raw/compressedDepth:=/oak/stereo/image_raw/compressedDepth</remapping>
              <remapping>/oak/depth/image_raw/theora:=/oak/depth/image_raw/theora</remapping>
              <remapping>/oak/depth/camera_info:=/oak/stereo/camera_info</remapping>
            </ros>
        <min_depth>0.3</min_depth>
        <max_depth>12.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="oak_imu_frame">
    <sensor name="imu_sensor" type="imu">
    <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
    <frame_name>oak_imu_frame</frame_name>
        <ros>
          <remapping>~/out:=/oak/imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
</robot>
