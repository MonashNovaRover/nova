    <joint name="tr_ball" type="revolute">
        <origin xyz="-0.38332334962930325606 -0.067590249002697472269 -0.010000000000000064393" rpy="-1.940682273124183288 -0.95328403917359394448 -1.2457859294461617328" />
        <parent link="diffbar" />
        <child link="right_difflink" />
        <axis xyz="0 0 1"/>
        <limit effort="20" velocity="20" lower="-0.26179938779914940783" upper="0.26179938779914940783"/>
