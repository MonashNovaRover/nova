    <!-- End of Generated URDF -->
    <!-- Include additional xacro files-->
    <xacro:include filename="joints.xacro"/>
    <xacro:if value="$(arg auto_camera)">
        <xacro:include filename="$(find rover_description)/base/urdf/auto_camera.xacro"/>
    </xacro:if>
    
    <!-- Needs to be updated for new arm-->
    <xacro:if value="$(arg arm)">
        <xacro:include filename="$(find rover_description)/arm/urdf/arm.urdf.xacro" />
        <joint name="chassis_to_arm_base" type="fixed">
            <origin xyz="0 0.15 -0.06" rpy="0 0 1.57"/>
            <parent link="chassis" />
            <child link="arm_link" />
        </joint>
    </xacro:if>

    <xacro:unless value="$(arg gazebo)">
        <xacro:include filename="$(find rover_description)/base/urdf/ros2_control.xacro" />
        <xacro:rover_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>
    </xacro:unless>

    <xacro:if value="$(arg gazebo)">
        <xacro:include filename="$(find rover_description)/base/urdf/gz_ros2_control.xacro" />
    </xacro:if>

    <xacro:include filename="$(find rover_description)/base/urdf/p3d.xacro"/>
    <xacro:include filename="$(find rover_description)/base/urdf/odom.xacro"/>
    <xacro:include filename="$(find rover_description)/base/urdf/gps.xacro"/>

    <xacro:include filename="ckc.xacro"/>
    <xacro:include filename="$(find rover_description)/base/urdf/dynamic_joints.xacro"/>
</robot>