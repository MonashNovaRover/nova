<?xml version="1.0" encoding="utf-8"?>
<!-- Handle custom joints that are not supported by gazebo -->
<!-- Works except it breaks detachable joint for closing ckc -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <!-- Ball joint for top left on diff bar-->
    <link name="tl_diffball_1">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <link name="tl_diffball_2">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="tl_ball_roll" type="revolute">
        <parent link="diffbar"/>
        <child link="tl_diffball_1"/>
        <origin xyz="0.38332334967290787597 -0.067590248755372686618 -0.010000000000001729727" rpy="-1.1995263624187955109 -0.95290201305807298304 -1.8975045742137988114" />
        <axis xyz="1 0 0"/>
        <limit effort="20" velocity="20" lower="-0.26179938779914940783" upper="0.26179938779914940783"/>
    </joint>

    <joint name="tl_ball_pitch" type="revolute">
        <parent link="tl_diffball_1"/>
        <child link="tl_diffball_2"/>
        <axis xyz="0 1 0"/>
        <limit effort="20" velocity="20" lower="-0.26179938779914940783" upper="0.26179938779914940783"/>
    </joint>

    <joint name="tl_ball_yaw" type="continuous">
        <parent link="tl_diffball_2"/>
        <child link="left_difflink"/>
        <axis xyz="0 0 1"/>
        <limit effort="20" velocity="20" />
    </joint>

    <!-- Ball joint for bottom left on diff bar-->
    <link name="bl_diffball_1">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <link name="bl_diffball_2">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="bl_ball_roll" type="revolute">
        <parent link="left_difflink"/>
        <child link="bl_diffball_1"/>
        <origin xyz="-2.8310687127941491781e-15 -0.11550000000000194833 3.5527136788005009294e-15" rpy="3.1415926535897913396 0.20093653079504641967 3.1415926535897602534" />
        <axis xyz="1 0 0"/>
        <limit effort="20" velocity="20" lower="-0.26179938779914940783" upper="0.26179938779914940783"/>
    </joint>

    <joint name="bl_ball_pitch" type="revolute">
        <parent link="bl_diffball_1"/>
        <child link="bl_diffball_2"/>
        <axis xyz="0 1 0"/>
        <limit effort="20" velocity="20" lower="-0.26179938779914940783" upper="0.26179938779914940783"/>
    </joint>

    <joint name="bl_ball_yaw" type="continuous">
        <parent link="bl_diffball_2"/>
        <child link="diffend"/>
        <axis xyz="0 0 1"/>
        <limit effort="20" velocity="20" />
    </joint>

        <!-- Ball joint for top right on diff bar-->
    <link name="tr_diffball_1">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <link name="tr_diffball_2">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="tr_ball_roll" type="revolute">
        <parent link="diffbar"/>
        <child link="tr_diffball_1"/>
        <origin xyz="-0.38332334962930325606 -0.067590249002697472269 -0.010000000000000064393" rpy="-1.940682273124183288 -0.95328403917359394448 -1.2457859294461617328" />
        <axis xyz="1 0 0"/>
        <limit effort="20" velocity="20" lower="-0.26179938779914940783" upper="0.26179938779914940783"/>
    </joint>

    <joint name="tr_ball_pitch" type="revolute">
        <parent link="tr_diffball_1"/>
        <child link="tr_diffball_2"/>
        <axis xyz="0 1 0"/>
        <limit effort="20" velocity="20" lower="-0.26179938779914940783" upper="0.26179938779914940783"/>
    </joint>

    <joint name="tr_ball_yaw" type="continuous">
        <parent link="tr_diffball_2"/>
        <child link="right_difflink"/>
        <axis xyz="0 0 1"/>
        <limit effort="20" velocity="20" />
    </joint>

    <!-- Ball joint for bottom right on diff bar-->
    <link name="br_diffball_1">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <link name="br_diffball_2">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="br_ball_roll" type="revolute">
        <parent link="right_difflink"/>
        <child link="br_diffball_1"/>
        <origin xyz="1.3711254354120683274e-14 -0.11549999999999875644 -6.0507154842071031453e-15" rpy="-4.0861161763381464503e-15 -0.42892757732778930002 -3.1415926535897278349" />
        <axis xyz="1 0 0"/>
        <limit effort="20" velocity="20" lower="-0.26179938779914940783" upper="0.26179938779914940783"/>
    </joint>

    <joint name="br_ball_pitch" type="revolute">
        <parent link="br_diffball_1"/>
        <child link="br_diffball_2"/>
        <axis xyz="0 1 0"/>
        <limit effort="20" velocity="20" lower="-0.26179938779914940783" upper="0.26179938779914940783"/>
    </joint>

    <joint name="br_ball_yaw" type="continuous">
        <parent link="br_diffball_2"/>
        <child link="diffend_2"/>
        <axis xyz="0 0 1"/>
        <limit effort="20" velocity="20" />
    </joint>

    <!-- Cylindrical joint for diffbar_pivot-->
    <joint name="diffbar_pivot" type="continuous">
        <origin xyz="-0.46700000121964435618 -4.8144507948394020372e-09 0.046505449483682306799" rpy="-1.5707963267949112129 -2.2257421151449106909e-09 1.5707963267948970021" />
        <parent link="chassis" />
        <child link="diffbar_mount" />
        <axis xyz="0 0 1"/>
        <limit effort="20" velocity="20"/>
        <joint_properties friction="0.0"/>
    </joint>

    <link name="diffbar_mount">
        <inertial>
        <mass value="0.00001"/>
        <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
    </link>

    <joint name="diffbar_slide" type="prismatic">
        <origin xyz="0 0 0.002" rpy="0 0 0" />
        <parent link="diffbar_mount" />
        <child link="diffbar" />
        <axis xyz="0 0 1"/>
        <limit effort="20" velocity="20" lower="0" upper="0.007"/>
        <joint_properties friction="0.0"/>
    </joint>
</robot>