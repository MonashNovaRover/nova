        <!-- Replace diffend to leg joins with detachable joint system plugins to fulfill CKCs
        <joint name="diffend_left_join" type="fixed">
            <pose>0.40426600250801236758 0.30025535313025775164 0.053851334870506306629
                -1.8619274120612665513 -1.3359274760854644715 -0.94867820928403723268</pose>
            <parent>leftleg</parent>
            <child>diffend_2</child>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <effort>1</effort>
                    <velocity>20</velocity>
                </limit>
            </axis>
        </joint>

        <joint name="diffend_right_join" type="fixed">
            <pose>-0.44247573240134774331 0.27749379793288275753 0.10927620857091185913
                -1.1277727216537536403 -0.34595260740530425769 1.7685930445325686033</pose>
            <parent>rightleg</parent>
            <child>diffend</child>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <effort>1</effort>
                    <velocity>20</velocity>
                </limit>
            </axis>
        </joint>
        -->

        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>leftleg</parent_link>
            <child_model>rover</child_model>
            <child_link>diffend_2</child_link>
            <attach_topic>close_loop_left</attach_topic>
        </plugin>

        <plugin filename="libgz-sim-detachable-joint-system.so" name="gz::sim::systems::DetachableJoint">
            <parent_link>rightleg</parent_link>
            <child_model>rover</child_model>
            <child_link>diffend</child_link>
            <attach_topic>close_loop_right</attach_topic>
        </plugin>

    </model>
