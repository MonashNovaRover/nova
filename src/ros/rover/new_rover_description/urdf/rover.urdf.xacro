<?xml version="1.0" encoding="utf-8"?>
<!-- Generated using onshape-to-robot and modified to include CKCs and ball joints by Anthony Lew -->
<!-- Notes:
      - Need to rename ankle pivots and wheels to fit current joint controller naming scheme
      - CKC is handled in ckc.xacro
      - joints.xacro handles ball joints and other non-vanilla joints
-->
<robot name="rover"  xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <!-- Loading args -->
    <xacro:arg name="gazebo" default="false"/>
    <xacro:arg name="use_mock_hardware" default="false"/>
    <xacro:arg name="arm" default="false"/>
    <xacro:arg name="auto_camera" default="true"/>
    <xacro:arg name="robot_name" default="rover"/>

    <!-- Robot properties-->
    <gazebo>
        <self_collide>false</self_collide>
    </gazebo>

    <!-- Dummy base link to prevent issues-->
    <link name="base_link" />
    <!-- Positions the chassis mesh in space relative to the wheel base (Stolen from Waratah and may need to be configured)-->
