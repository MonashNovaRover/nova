    </xacro:if>

    
    <xacro:if value="$(arg arm)">
        <xacro:include filename="$(find rover_description)/urdf/arm.urdf.xacro" />
        <!-- Add arm to chassis joint here-->
    </xacro:if>

    <xacro:unless value="$(arg gazebo)">
        <xacro:include filename="$(find new_rover_description)/urdf/ros2_control.xacro" />
        <xacro:rover_ros2_control use_mock_hardware="$(arg use_mock_hardware)"/>
    </xacro:unless>

    <xacro:if value="$(arg gazebo)">
        <xacro:include filename="$(find new_rover_description)/urdf/gz_ros2_control.xacro" />
    </xacro:if>
</robot>