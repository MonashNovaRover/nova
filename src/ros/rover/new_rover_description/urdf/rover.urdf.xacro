<?xml version="1.0" encoding="utf-8"?>
<!-- Generated using onshape-to-robot and modified to include CKCs and ball joints by Anthony Lew -->
<!-- Notes:
      - Need to rename ankle pivots and wheels to fit current joint controller naming scheme
      - CKC is handled in ckc.xacro
      - joints.xacro handles ball joints and other non-vanilla joints
      - ankles collision handles both ankle and ankle motor
-->
