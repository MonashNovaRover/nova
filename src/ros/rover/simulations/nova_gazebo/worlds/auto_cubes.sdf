<?xml version="1.0" ?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <world name="auto">
    <xacro:include filename="includes/world_base.xacro"/>
    <xacro:nova_world_physics/>
    <xacro:nova_world_plugins/>
    <xacro:nova_world_directional_sun cast_shadows="true"/>
    <xacro:nova_world_scene shadows="false"/>
    <xacro:nova_world_spherical_coordinates
      latitude_deg="38.367167"
      longitude_deg="-110.714849"
      elevation="1370.0192172613349"
      heading_deg="0"
      world_frame_orientation="ENU"/>
    <xacro:nova_world_orbit_camera_gui camera_pose="0 0 34 0 1.570796 0"/>

    <include>
      <uri>model://arc_terrain</uri>
    </include>

    <model name='red_cube'>
      <pose>6.5 -6.0 2.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
            <material>
              <ambient>0.5 0.1 0.1 1</ambient>   <!-- Dark red ambient -->
              <diffuse>1 0 0 1</diffuse>         <!-- Pure red under light -->
              <specular>0.2 0.2 0.2 1</specular> <!-- Slight shine -->
              <emissive>0 0 0 1</emissive>       <!-- No self-glow -->
            </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name='blue_cube'>
      <pose>5.5 -4.0 0.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
            <material>
                <ambient>0.1 0.1 0.5 1</ambient>   <!-- Dark blue ambient -->
                <diffuse>0 0 1 1</diffuse>         <!-- Pure blue under light -->
                <specular>0.2 0.2 0.2 1</specular> <!-- Slight shine -->
                <emissive>0 0 0 1</emissive>       <!-- No self-glow -->
            </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name='green_cube'>
      <pose>7.5 -2.0 3.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
            <material>
                <ambient>0.1 0.5 0.1 1</ambient>   <!-- Dark green ambient -->
                <diffuse>0 1 0 1</diffuse>         <!-- Pure green under light -->
                <specular>0.2 0.2 0.2 1</specular> <!-- Slight shine -->
                <emissive>0 0 0 1</emissive>       <!-- No self-glow -->
            </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name='white_cube'>
      <pose>3.5 -4.0 2.5 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
            <material>
                <ambient>0.6 0.6 0.6 1</ambient>   <!-- Light gray ambient -->
                <diffuse>1 1 1 1</diffuse>         <!-- Pure white under light -->
                <specular>0.3 0.3 0.3 1</specular> <!-- Slight shine -->
                <emissive>0 0 0 1</emissive>       <!-- No self-glow -->
            </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
      </link>
    </model>
    
    <include>
      <uri>model://ar_tag</uri>
      <pose>10 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>