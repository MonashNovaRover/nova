<?xml version="1.0" ?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <world name="flat">
    <xacro:include filename="includes/world_base.xacro"/>
    <xacro:nova_world_physics/>
    <xacro:nova_world_plugins/>
    <xacro:nova_world_ground_plane/>
    <xacro:nova_world_sun/>
    <xacro:nova_world_spherical_coordinates
      latitude_deg="38.406863"
      longitude_deg="-110.791055"
      elevation="1370.0"
      heading_deg="180"/>

    <!-- Random features for visual odometry and obstacle avoidance -->

    <model name='rocket_panel'>
      <pose>-1.85 -0.01 0.5 0 -0 0</pose>
      <link name='link'>
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>1.45833</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1.45833</iyy>
            <iyz>0</iyz>
            <izz>1.25</izz>
          </inertia>
          <pose>0 0 0 0 -0 0</pose>
        </inertial>
        <collision name='frame_collision'>
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
        <visual name='frame_visual'>
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.45 0.9 0.45 1</diffuse>
            <specular>0 0 0 0</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
        <collision name='keyboard_collision'>
          <pose> 0.5 0 0.7 0 1.5708 0 </pose>
          <geometry>
            <box>
              <size>0.123 0.357 0.037</size>
            </box>
          </geometry>
          <max_contacts>10</max_contacts>
          <surface>
            <contact>
              <ode/>
            </contact>
            <bounce/>
            <friction>
              <torsional>
                <ode/>
              </torsional>
              <ode/>
            </friction>
          </surface>
        </collision>
        <visual name='keyboard_visual'>
          <pose> 0.5 0 0.7 0 1.5708 0 </pose>
          <geometry>
            <box>
              <size>0.123 0.357 0.037</size>
            </box>
          </geometry>
          <material> 
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.45 0.45 0.9 1</diffuse>
            <specular>0 0 0 0</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>

    <xacro:nova_world_scene shadows="true"/>

    <xacro:nova_world_orbit_camera_gui camera_pose="0 0 15 0 1.570796 0"/>

  </world>
</sdf>
