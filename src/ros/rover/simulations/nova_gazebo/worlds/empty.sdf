<?xml version="1.0" ?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <world name="empty">
    <xacro:include filename="includes/world_base.xacro"/>
    <xacro:nova_world_physics/>
    <xacro:nova_world_plugins/>
    <xacro:nova_world_spherical_coordinates
      latitude_deg="38.406863"
      longitude_deg="-110.791055"
      elevation="1370.0"
      heading_deg="180"/>
    <xacro:nova_world_directional_sun cast_shadows="true"/>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>