<?xml version="1.0" encoding="utf-8"?>
<!--This is a file for the p3d plugin for the rover in gazebo. This file is referenced at the bottom of rover.urdf.xacro, 
which is how it gets added to the gazebo sim. Author/s: Victor Bartlinski-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
  
  <gazebo>
    <plugin name="gazebo_ros_p3d" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=ground_truth_pose</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>map</frame_name>
      <update_rate>2</update_rate>
      <gaussian_noise>0.01</gaussian_noise>
    </plugin>
  </gazebo>

</robot>