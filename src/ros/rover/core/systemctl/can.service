[Unit]
Description=Runs can start for can0 and can1 on startup
Requires=network-online.target network.target local-fs.target
After=network-online.target network.target local-fs.target

[Service]
User=root
Group=sudo
Type=oneshot
ExecStartPre=-/home/nvidia/.nix-profile/bin/can stop can0
ExecStartPre=-/home/nvidia/.nix-profile/bin/can stop can1
ExecStart=/home/nvidia/.nix-profile/bin/can start can0
ExecStart=/home/nvidia/.nix-profile/bin/can start can1
TimeoutStartSec=5
Restart=on-failure

[Install]
WantedBy=multi-user.target
