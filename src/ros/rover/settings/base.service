[Unit]
Description=Runs the base station launch file in a new screen
Requires=network-online.target network.target local-fs.target
After=network-online.target network.target local-fs.target

[Service]
User=liam
Group=users
Type=forking
ExecStart=/home/liam/base.sh
TimeoutStartSec=5
Restart=on-failure

[Install]
WantedBy=multi-user.target
