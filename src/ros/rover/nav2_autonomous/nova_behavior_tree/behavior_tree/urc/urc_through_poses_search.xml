<!--
  This Behavior Tree replans the global path periodically at 1 Hz through an array of poses
continuously
   and it also has recovery actions specific to planning / control as well as general system issues.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="Recovery">
    <ReactiveFallback name="RecoveryFallback">
      <GoalUpdated />
      <RoundRobin name="RecoveryActions">
        <Sequence name="ClearingActions">
          <ClearEntireCostmap name="ClearLocalCostmap-Subtree"
            service_name="local_costmap/clear_entirely_local_costmap" />
          <ClearEntireCostmap name="ClearGlobalCostmap-Subtree"
            service_name="global_costmap/clear_entirely_global_costmap" />
        </Sequence>
        <Spin spin_dist="1.57" />
        <Wait wait_duration="5" />
        <BackUp backup_dist="0.30" backup_speed="0.05" />
      </RoundRobin>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="NavToPoseWithReplanningAndRecovery">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateToPoseWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Sequence name="PlanAndSmoothPath">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" />
              <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" />
            </Sequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
              service_name="global_costmap/clear_entirely_global_costmap" />
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath" />
          <ClearEntireCostmap name="ClearLocalCostmap-Context"
            service_name="local_costmap/clear_entirely_local_costmap" />
        </RecoveryNode>
      </PipelineSequence>
      <SubTreePlus ID="Recovery" __autoremap="true" />
    </RecoveryNode>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <Sequence>
      <LED name="Start" service_name="autonomous/start" />
      <ReactiveSequence name="FindAndApproachObject">
        <ReactiveFallback name="NavThroughPosesAndSearchForObject">
          <!-- Exit the fallback when the object is found-->
          <CheckDetected id="0" detection_type="tag" />

          <Sequence>
            <GetFinalGoal goals="{goals}" final_goal="{search_origin}" />
            <!-- Nav through poses -->
            <ReactiveFallback>
              <!-- Conduct a spin on reaching a goal-->
              <GoalReached goal="{search_origin}" robot_base_frame="base_link" />
              <KeepRunningUntilFailure>
                <Sequence>
                  <GetFirstGoal goals="{goals}" first_goal="{goal}" />
                  <SubTreePlus ID="NavToPoseWithReplanningAndRecovery" goal="{goal}"
                    __autoremap="true" />
                  <RemovePassedGoals input_goals="{goals}" output_goals="{goals}"
                    radius="0.5" />
                </Sequence>
              </KeepRunningUntilFailure>
              <!-- Navigate through search goal poses -->
            </ReactiveFallback>

            <!-- Compute search points -->
            <ComputeSearchGoals search_origin="{search_origin}" search_radius="2" num_points="6"
              search_goals="{search_goals}" />
            <GetFinalGoal goals="{search_goals}" final_goal="{final_goal}" />

            <!-- Navigate through search points, spinning each time-->
            <!-- Keep going until we've exhausted all search goals -->
            <!-- NOTE: This value should be {n_search_goals + 1}-->
            <ReactiveFallback>
              <!-- Conduct a spin on reaching a goal-->
              <Sequence>
                <GoalReached
                  goal="{final_goal}" robot_base_frame="base_link" />
                <ForceSuccess>
                  <Spin spin_dist="6.28" time_allowance="25" />
                </ForceSuccess>
              </Sequence>
              <KeepRunningUntilFailure>
                <Sequence>
                  <GetFirstGoal goals="{search_goals}" first_goal="{goal}" />
                  <SubTreePlus ID="NavToPoseWithReplanningAndRecovery" goal="{goal}"
                    __autoremap="true" />
                  <ForceSuccess>
                    <Spin spin_dist="6.28" time_allowance="25" />
                  </ForceSuccess>
                  <RemovePassedGoals
                    input_goals="{search_goals}" output_goals="{search_goals}"
                    radius="0.5" />
                </Sequence>
              </KeepRunningUntilFailure>
              <!-- Navigate through search goal poses -->
            </ReactiveFallback>
          </Sequence>
        </ReactiveFallback>
        <!-- Object has been found - get it's latest position in the map frame -->
        <QueryPosition detection_type="tag" id="0" position="{position}" />
        <!-- Navigate to object position -->
        <SubTreePlus ID="NavToPoseWithReplanningAndRecovery" goal="{position}"
          __autoremap="true" />
      </ReactiveSequence>
      <LED name="Success" service_name="autonomous/success" />
    </Sequence>
  </BehaviorTree>
</root>
