<?xml version="1.0"?>
<root main_tree_to_execute="MainTree">
    <!-- ////////// -->
    <BehaviorTree ID="MainTree">
        <Sequence>
            <Action ID="LED" name="Start" server_timeout="" service_name="autonomous/start"/>
            <ReactiveSequence name="FindAndApproachObject">
                <ReactiveFallback name="NavThroughPosesAndSearchForObject">
                    <Condition ID="CheckDetected" detection_type="{detection_type}" id="{detection_id}"/>
                    <Sequence>
                        <Condition ID="GetFinalGoal" final_goal="{search_origin}" goals="{goals}"/>
                        <ReactiveFallback>
                            <Condition ID="GoalReached" global_frame="" goal="{search_origin}" robot_base_frame="base_link"/>
                            <KeepRunningUntilFailure>
                                <Sequence>
                                    <Condition ID="GetFirstGoal" first_goal="{goal}" goals="{goals}"/>
                                    <SubTree ID="NavToPoseWithReplanningAndRecovery" __autoremap="true" goal="{goal}"/>
                                    <Action ID="RemovePassedGoals" global_frame="" input_goals="{goals}" output_goals="{goals}" radius="0.5" robot_base_frame=""/>
                                </Sequence>
                            </KeepRunningUntilFailure>
                        </ReactiveFallback>
                        <Condition ID="ComputeSearchGoals" num_points="6" search_goals="{search_goals}" search_origin="{search_origin}" search_radius="2"/>
                        <Condition ID="GetFinalGoal" final_goal="{final_goal}" goals="{search_goals}"/>
                        <ReactiveFallback>
                            <Sequence>
                                <Condition ID="GoalReached" global_frame="" goal="{final_goal}" robot_base_frame="base_link"/>
                                <ForceSuccess>
                                    <Action ID="Spin" error_code_id="" server_name="" server_timeout="" spin_dist="6.28" time_allowance="25"/>
                                </ForceSuccess>
                            </Sequence>
                            <KeepRunningUntilFailure>
                                <Sequence>
                                    <Condition ID="GetFirstGoal" first_goal="{goal}" goals="{search_goals}"/>
                                    <SubTree ID="NavToPoseWithReplanningAndRecovery" __autoremap="true" goal="{goal}"/>
                                    <ForceSuccess>
                                        <Action ID="Spin" error_code_id="" server_name="" server_timeout="" spin_dist="6.28" time_allowance="25"/>
                                    </ForceSuccess>
                                    <Action ID="RemovePassedGoals" global_frame="" input_goals="{search_goals}" output_goals="{search_goals}" radius="0.5" robot_base_frame=""/>
                                </Sequence>
                            </KeepRunningUntilFailure>
                        </ReactiveFallback>
                    </Sequence>
                </ReactiveFallback>
                <Condition ID="QueryPosition" detection_type="{detection_type}" id="{detection_id}" position="{position}"/>
                <SubTree ID="NavToPoseWithReplanningAndRecovery" __autoremap="true" goal="{position}"/>
            </ReactiveSequence>
            <Action ID="LED" name="Success" server_timeout="" service_name="autonomous/success"/>
        </Sequence>
        <Spin spin_dist="1.57" />
        <Wait wait_duration="5" />
        <BackUp backup_dist="0.30" backup_speed="0.05" />
      </RoundRobin>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="NavToPoseWithReplanningAndRecovery">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateToPoseWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <!-- <Sequence name="PlanAndSmoothPath">
              <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" />
            </Sequence> -->
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" />
            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
              service_name="global_costmap/clear_entirely_global_costmap" />
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath" />
          <ClearEntireCostmap name="ClearLocalCostmap-Context"
            service_name="local_costmap/clear_entirely_local_costmap" />
        </RecoveryNode>
      </PipelineSequence>
      <SubTreePlus ID="Recovery" __autoremap="true" />
    </RecoveryNode>
  </BehaviorTree>

  <BehaviorTree ID="NavCloseToPoseWithReplanningAndRecovery">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateToPoseWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Sequence name="PlanAndTruncatePath">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" />
              <TruncatePath distance="1.1" input_path="{path}" output_path="{path}" />
              <!-- <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}" /> -->
            </Sequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
              service_name="global_costmap/clear_entirely_global_costmap" />
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath" />
          <ClearEntireCostmap name="ClearLocalCostmap-Context"
            service_name="local_costmap/clear_entirely_local_costmap" />
        </RecoveryNode>
      </PipelineSequence>
      <SubTreePlus ID="Recovery" __autoremap="true" />
    </RecoveryNode>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <Sequence>
      <LED name="Start" service_name="LED/auto_active" />
      <ReactiveSequence name="FindAndApproachObject">
        <ReactiveFallback name="NavThroughPosesAndSearchForObject">
          <!-- Exit the fallback when the object is found-->
          <CheckDetected id="0" detection_type="tag" />

          <Sequence>
            <GetFinalGoal goals="{goals}" final_goal="{search_origin}" />
            <!-- Nav through poses -->
            <ReactiveFallback>
              <!-- Conduct a spin on reaching a goal-->
              <GoalReached goal="{search_origin}" robot_base_frame="base_link" />
              <KeepRunningUntilFailure>
                <Sequence>
                  <GetFirstGoal goals="{goals}" first_goal="{goal}" />
                  <SubTreePlus ID="NavToPoseWithReplanningAndRecovery" goal="{goal}"
                    __autoremap="true" />
                  <RemovePassedGoals input_goals="{goals}" output_goals="{goals}"
                    radius="0.5" />
                </Sequence>
                <Action ID="Spin" error_code_id="" server_name="" server_timeout="" spin_dist="1.57" time_allowance=""/>
                <Action ID="Wait" server_name="" server_timeout="" wait_duration="5"/>
                <Action ID="BackUp" backup_dist="0.30" backup_speed="0.05" error_code_id="" server_name="" server_timeout="" time_allowance=""/>
            </Control>
        </ReactiveFallback>
        <!-- Object has been found - get it's latest position in the map frame -->
        <QueryPosition detection_type="tag" id="0" position="{position}" />
        <!-- Navigate to object position -->
        <SubTreePlus ID="NavCloseToPoseWithReplanningAndRecovery" goal="{position}"
          __autoremap="true" />
      </ReactiveSequence>
      <LED name="Success" service_name="LED/auto_success" />
    </Sequence>
  </BehaviorTree>
</root>
