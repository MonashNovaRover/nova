<!--
  This Behavior Tree replans the global path periodically at 1 Hz through an array of poses continuously
   and it also has recovery actions specific to planning / control as well as general system issues.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="FindAndApproachTag">
      <ReactiveFallback name="NavThroughPosesAndSearchForTag"> 
        <!-- Exit the fallback when the tag is found-->
        <FoundTag tag_id="{tag_id}"/>

        <Sequence>
          <!-- Nav through poses -->
          <Subtree ID="NavThroughPosesWithReplanningAndRecovery" goals="goals" node="{node}" tf_buffer="{tf_buffer}" bt_loop_duration="{bt_loop_duration}" server_timeout="{server_timeout}"/>

          <!-- Compute search points -->
          <ComputeTagSearchGoals approximate_goal="{final_goal}" search_goals="{search_goals}"/>

          <!-- Navigate through search points, spinning each time-->
          <ReactiveFallback>
            <!-- Search complete-->
            <GoalsEmpty goals="{search_goals}"/>
            <!-- Conduct a spin on reaching a goal-->
            <Sequence>
              <FirstGoalReached goals="{search_goals}" global_frame="map" robot_base_frame="base_link"/>
              <Spin spin_dist="6.28"/>
            </Sequence>
            <!-- Navigate through search goal poses -->
            <Subtree ID="NavThroughPosesWithReplanningAndRecovery" goals="search_goals" node="{node}" tf_buffer="{tf_buffer}" bt_loop_duration="{bt_loop_duration}" server_timeout="{server_timeout}"/>
          </ReactiveFallback>
        </Sequence>
      </ReactiveFallback>
      <!-- Tag has been found - get it's latest position in the map frame -->
      <QueryTagPosition tag_id="{tag_id}" tag_position="{tag_position}"/>
      <!-- Navigate to tag position -->
      <SubTree ID="NavToPoseWithReplanningAndRecovery" goal="{tag_position}"/>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="Recovery">
    <ReactiveFallback name="RecoveryFallback">
      <GoalUpdated/>
      <RoundRobin name="RecoveryActions">
        <Sequence name="ClearingActions">
          <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
          <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
        </Sequence>
        <Spin spin_dist="1.57"/>
        <Wait wait_duration="5"/>
        <BackUp backup_dist="0.30" backup_speed="0.05"/>
      </RoundRobin>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="NavToPoseWithReplanningAndRecovery">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateToPoseWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <Subtree ID="Recovery"/>
    </RecoveryNode>
  </BehaviorTree>


  <BehaviorTree ID="NavThroughPosesWithReplanningAndRecovery">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateThroughPosesWithReplanning">
        <RateController hz="0.333">
          <RecoveryNode number_of_retries="1" name="ComputePathThroughPoses">
            <ReactiveSequence>
              <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.7"/>
              <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
            </ReactiveSequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <Subtree ID="Recovery"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
