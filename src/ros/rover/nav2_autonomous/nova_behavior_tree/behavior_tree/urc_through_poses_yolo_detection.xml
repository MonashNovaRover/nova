<!--
  This Behavior Tree replans the global path periodically at 1 Hz through an array of poses
continuously
   and it also has recovery actions specific to planning / control as well as general system issues.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <include path="./nav_to_pose_with_replanning_and_recovery.xml" />
  <include path="./nav_through_poses_with_replanning_and_recovery.xml" />
  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="FindAndApproachObject">
      <ReactiveFallback name="NavThroughPosesAndSearchForObject">
        <!-- Exit the fallback when the object is found-->
        <FoundObject object_id="{id}" />

        <Sequence>
          <!-- Nav through poses -->
          <Subtree ID="NavThroughPosesWithReplanningAndRecovery" goals="{goals}" node="{node}"
            tf_buffer="{tf_buffer}" bt_loop_duration="{bt_loop_duration}"
            server_timeout="{server_timeout}" />

          <!-- Compute search points -->
          <ComputeObjectSearchGoals approximate_goal="{final_goal}" search_goals="{search_goals}" />

          <!-- Navigate through search points, spinning each time-->
          <ReactiveFallback>
            <!-- Search complete-->
            <GoalsEmpty goals="{search_goals}" />
            <!-- Conduct a spin on reaching a goal-->
            <Sequence>
              <FirstGoalReached goals="{search_goals}" global_frame="map"
                robot_base_frame="base_link" />
              <Spin spin_dist="6.28" />
            </Sequence>
            <!-- Navigate through search goal poses -->
            <Subtree ID="NavThroughPosesWithReplanningAndRecovery" goals="search_goals"
              node="{node}" tf_buffer="{tf_buffer}" bt_loop_duration="{bt_loop_duration}"
              server_timeout="{server_timeout}" />
          </ReactiveFallback>
        </Sequence>
      </ReactiveFallback>
      <!-- Object has been found - get it's latest position in the map frame -->
      <QueryPosition id="{id}" position="{position}" />
      <!-- Navigate to object position -->
      <SubTree ID="NavToPoseWithReplanningAndRecovery" goal="{position}" />
    </ReactiveSequence>
  </BehaviorTree>
</root>
