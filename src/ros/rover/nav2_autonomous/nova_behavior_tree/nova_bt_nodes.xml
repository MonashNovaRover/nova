<?xml version="1.0"?>
<root BTCPP_format="4">
  <TreeNodesModel>
    <!-- ############################### ACTION NODES ################################# -->
    <Action ID="BlackboardPublisher">
      <input_port name="topic_name">ROS topic for publishing</input_port>
    </Action>
    
    <Action ID="SaveCubePoses">
      <input_port name="cube_poses">List of cube poses</input_port>
      <input_port name="file_path">File to save cube poses to</input_port>
    </Action>

    <Action ID="RemovePassedGoalsAndCubes">
      <input_port name="cube_poses">List of most recent cube poses</input_port>
      <input_port name="cube_tolerance">Radius to determine whether the current goal is the cube goal</input_port>
      <input_port name="input_goals">Original goals to remove viapoints from</input_port>
      <input_port name="radius">Radius to goal for it to be considered for removal</input_port>
      <input_port name="yaw_tolerance">Orientation tolerance in radians</input_port>
      <input_port name="global_frame">Global frame</input_port>
      <input_port name="robot_base_frame">Robot base frame</input_port>
      <output_port name="output_goals">Goals with passed viapoints removed</output_port>
      <output_port name="visited_ids">visited_ids[i] = true if visited, false otherwise</output_port>
    </Action>

    <Action ID="RemovePassedGoalsAndARTags">
      <input_port name="input_goal">AR tag goal</input_port>
      <input_port name="id">ID of detected AR tag</input_port>
      <input_port name="tag_tolerance">Radius to determine whether the current goal is the AR tag goal</input_port>
      <input_port name="input_goals">Original goals to remove viapoints from</input_port>
      <input_port name="radius">Radius to goal for it to be considered for removal</input_port>
      <input_port name="yaw_tolerance">Orientation tolerance in radians</input_port>
      <input_port name="global_frame">Global frame</input_port>
      <input_port name="robot_base_frame">Robot base frame</input_port>
      <output_port name="output_goals">Goals with passed viapoints removed</output_port>
      <output_port name="seen_ids">IDs of visited AR tags</output_port>
    </Action>
    
    <Action ID="UpdateGoal">
      <input_port name="goal_type">Type of goal being updated (for logging)</input_port>
      <input_port name="input_goal">Goal to add as viapoint</input_port>
      <input_port name="input_goals">Original goals to add viapoints into</input_port>
      <input_port name="radius">Radius to next goal for it to be considered an update</input_port>
      <output_port name="output_goals">Goals with new viapoints added/updated</output_port>
    </Action>

    <Action ID="UpdateGoals">
      <input_port name="goal_type">Type of goal being updated (for logging)</input_port>
      <input_port name="current_pose">The current pose of the rover</input_port>
      <input_port name="goals">Goals to add as viapoints</input_port>
      <input_port name="input_goals">Original goals to add viapoints into</input_port>
      <input_port name="update_radius">Radius to next goal for it to be considered an update</input_port>
      <input_port name="goal_radius">Radius away from actual pose to set goal</input_port>
      <output_port name="output_goals">Goals with new viapoints added/updated</output_port>
    </Action>

    <Action ID="SaveImage">
      <input_port name="service_name">Service name</input_port>
      <input_port name="server_timeout">Server timeout</input_port>
    </Action>

    <Action ID="LED">
      <input_port name="service_name">Service name</input_port>
      <input_port name="server_timeout">Server timeout</input_port>
    </Action>

    <!-- ############################### CONDITION NODES ############################## -->
    <Condition ID="CubeDetected">
      <input_port name="visited_ids">visited_ids[i] = true if visited, false otherwise</input_port>
      <output_port name="current_pose">The current pose of the rover</output_port>
      <output_port name="cube_goals">Goals of detected cubes</output_port>
      <output_port name="cube_poses">List of most recent cube poses</output_port>
    </Condition>
    
    <Condition ID="ARTagDetected">
      <input_port name="seen_ids">Visited AR tags IDs</input_port>
      <output_port name="id">Detected AR tag ID</output_port>
      <output_port name="goal">Detected AR tag pose</output_port>
    </Condition>

    <Condition ID="GetFirstGoal">
      <input_port name="goals">List of goals</input_port>
      <output_port name="first_goal">First Goal</output_port>
    </Condition>

    <Condition ID="CheckDetected">
      <input_port name="id">id as string</input_port>
      <input_port name="detection_type">tag or object</input_port>
    </Condition>

    <Condition ID="GetFinalGoal">
      <input_port name="goals">List of goals</input_port>
      <output_port name="final_goal">Final Goal</output_port>
    </Condition>

    <Condition ID="QueryPosition">
      <input_port name="id">ID of tag or object</input_port>
      <input_port name="detection_type">'tag' or 'object'</input_port>
      <output_port name="position">PoseStamped</output_port>
    </Condition>

    <Condition ID="ComputeSearchGoals">
      <input_port name="search_origin">The center of the search region</input_port>
      <input_port name="search_radius">The radius (m) to search around the center</input_port>
      <input_port name="num_points">Num points in search circle</input_port>
      <output_port name="search_goals">Search Goals</output_port>
    </Condition>

    <Condition ID="FirstGoalReached">
      <input_port name="goals">Waypoints</input_port>
      <input_port name="global_frame">Reference frame</input_port>
      <input_port name="robot_base_frame">Robot base frame</input_port>
    </Condition>

    <Condition ID="GoalsEmpty">
      <input_port name="goals">Waypoints</input_port>
    </Condition>

    <!-- ############################### CONTROL NODES ################################ -->

    <!-- ############################### DECORATOR NODES ############################## -->

    <!-- ############################### SUBTREE NODES ################################ -->
    <SubTree ID="NavThroughPosesWithReplanningAndRecovery">
      <input_port default="true" name="__shared_blackboard">If false (default), the Subtree has an
        isolated blackboard and needs port remapping</input_port>
      <input_port default="{goals}" name="goals" />
    </SubTree>

    <SubTree ID="NavToPoseWithReplanningAndRecovery">
      <input_port default="true" name="__shared_blackboard">If false (default), the Subtree has an
        isolated blackboard and needs port remapping</input_port>
      <input_port default="{goal}" name="goal" />
    </SubTree>

    <SubTree ID="Recovery">
      <input_port default="false" name="__shared_blackboard">If false (default), the Subtree has an
        isolated blackboard and needs port remapping</input_port>
    </SubTree>
  </TreeNodesModel>
</root>
