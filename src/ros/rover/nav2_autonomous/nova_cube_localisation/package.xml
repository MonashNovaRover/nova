<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nova_cube_localisation</name>
  <version>0.0.0</version>
  <description>Nodes to track cube Marker locations and capture images of placards</description>
  <maintainer email="novaroverteam@monash.edu">nova</maintainer>
  <license>BSD-3-Clause</license>

  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_opencv</depend>
  <depend>image_geometry</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
