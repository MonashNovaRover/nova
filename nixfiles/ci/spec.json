{
    "enabled": 1,
    "hidden": true,
    "description": "Project jobset generator",
    "nixexprinput": "nova",
    "nixexprpath": "nixfiles/ci/default.nix",
    "checkinterval": 60,
    "schedulingshares": 100,
    "enableemail": false,
    "enable_dynamic_run_command": true,
    "emailoverride": "",
    "keepnr": 3,
    "inputs": {
        "nixpkgs": {
            "type": "git",
            "value": "git@github.com:NixOS/nixpkgs.git nixos-unstable",
            "emailresponsible": false
        },
        "nova-monorepo": {
            "type": "git",
            "value": "git@github.com:MonashNovaRover/nova.git fix/hydra",
            "emailresponsible": false
        },
        "nova-pr-json": {
            "type": "githubpulls",
            "value": "MonashNovaRover nova",
            "emailresponsible": false
        },
        "gui-pr-json": {
            "type": "githubpulls",
            "value": "MonashNovaRover gui",
            "emailresponsible": false
        },
        "coms_utils-pr-json": {
            "type": "githubpulls",
            "value": "MonashNovaRover coms_utils",
            "emailresponsible": false
        },
        "libblcmd-pr-json": {
            "type": "githubpulls",
            "value": "MonashNovaRover libblcmd",
            "emailresponsible": false
        },
        "libcanmd-pr-json": {
            "type": "githubpulls",
            "value": "MonashNovaRover libcanmd",
            "emailresponsibe": false
        }

    }
}