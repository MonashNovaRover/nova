{
    "enabled": 1,
    "hidden": true,
    "description": "Project jobset generator",
    "nixexprinput": "src",
    "nixexprpath": "ci/default.nix",
    "checkinterval": 60,
    "schedulingshares": 100,
    "enableemail": false,
    "enable_dynamic_run_command": true,
    "emailoverride": "",
    "keepnr": 3,
    "inputs": {
        "nixpkgs": {
            "type": "git",
            "value": "git@github.com:NixOS/nixpkgs.git nixos-unstable",
            "emailresponsible": false
        },
        "src": {
            "type": "git",
            "value": "git@github.com:MonashNovaRover/nixfiles.git",
            "emailresponsible": false
        }
    }
}